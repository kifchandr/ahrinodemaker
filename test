# ================================================================== #
# Детекторы «уже настроено» — снимают галочку с блока по умолчанию,
# если соответствующая настройка на сервере уже присутствует.
# ================================================================== #
def _pkg_installed(pkg: str) -> bool:
    return subprocess.run(["dpkg", "-s", pkg], capture_output=True).returncode == 0


def _detect_packages() -> bool:
    return all(_pkg_installed(p) for p in ("fail2ban", "ufw", "unattended-upgrades"))


def _detect_fail2ban() -> bool:
    return os.path.isfile("/etc/fail2ban/jail.local")


def _detect_ufw() -> bool:
    res = subprocess.run(["ufw", "status"], capture_output=True, text=True)
    return res.returncode == 0 and "Status: active" in res.stdout


def _detect_network() -> bool:
    return os.path.isfile("/etc/sysctl.d/99-vpn.conf")


def _detect_time_cron() -> bool:
    tz = subprocess.run(["timedatectl", "show", "-p", "Timezone", "--value"],
                        capture_output=True, text=True)
    tz_ok = tz.returncode == 0 and tz.stdout.strip() == "Europe/Moscow"
    cr = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
    cron_ok = cr.returncode == 0 and re.search(
        r"(?m)^\s*0\s+3\s+\*\s+\*\s+[*1]\s+.*?/sbin/reboot\b", cr.stdout) is not None
    return tz_ok and cron_ok


def _detect_remnanode_logs() -> bool:
    return (os.path.isfile("/etc/logrotate.d/remnanode")
            and os.path.isdir("/var/log/remnanode"))


def _detect_torrent() -> bool:
    return _pkg_installed("tblocker") and os.path.isfile("/opt/tblocker/config.yaml")


def _detect_trafficguard() -> bool:
    return (os.path.exists("/usr/local/bin/traffic-guard")
            or os.path.isfile("/opt/trafficguard-manager.sh"))


DETECTORS = {
    "packages":       _detect_packages,
    "fail2ban":       _detect_fail2ban,
    "ufw":            _detect_ufw,
    "network":        _detect_network,
    "time_cron":      _detect_time_cron,
    "remnanode_logs": _detect_remnanode_logs,
    "torrent":        _detect_torrent,
    "trafficguard":   _detect_trafficguard,
}


def detect_applied() -> dict[str, bool]:
    """Возвращает {ключ_блока: True|False} — настроен ли блок уже сейчас."""
    result: dict[str, bool] = {}
    for key, _, _ in BLOCKS:
        det = DETECTORS.get(key)
        try:
            result[key] = bool(det()) if det else False
        except Exception:
            result[key] = False
    return result


