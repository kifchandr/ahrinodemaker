def _setup_egress_filter() -> None:
    """Скрипт + systemd service/timer для резервной блокировки портов через nft."""
    os.makedirs(INSTALL_DIR, exist_ok=True)
    script_path = f"{INSTALL_DIR}/apply-torrent-egress-filter.sh"
    with open(script_path, "w", encoding="utf-8") as f:
        f.write(EGRESS_SCRIPT)
    os.chmod(script_path, 0o755)
    with open("/etc/systemd/system/torrent-egress-filter.service", "w", encoding="utf-8") as f:
        f.write(EGRESS_SERVICE)
    with open("/etc/systemd/system/torrent-egress-filter.timer", "w", encoding="utf-8") as f:
        f.write(EGRESS_TIMER)
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "--now",
         "torrent-egress-filter.service", "torrent-egress-filter.timer"], check=False)


