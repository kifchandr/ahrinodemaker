def find_compose_candidates() -> list[str]:
    """Возвращает список найденных docker-compose.yml, относящихся к ноде."""
    found: list[str] = []
    for p in COMPOSE_CANDIDATES:
        if os.path.isfile(p) and p not in found:
            found.append(p)
    # Глубокий поиск, если в стандартных местах ничего нет
    if not found:
        try:
            res = subprocess.run(
                ["bash", "-c",
                 "find /opt /root /home -maxdepth 4 -name 'docker-compose.y*ml' "
                 "-path '*remna*' 2>/dev/null | head -n 10"],
                capture_output=True, text=True,
            )
            for line in res.stdout.splitlines():
                line = line.strip()
                if line and os.path.isfile(line) and line not in found:
                    found.append(line)
        except Exception:
            pass
    return found


def _ask_compose_manual() -> str | None:
    raw = questionary.text(
        "Путь к docker-compose.yml ноды (Enter — пропустить добавление volume):",
        default="",
        style=CUSTOM_STYLE,
    ).ask()
    if not raw or not raw.strip():
        return None
    path = raw.strip()
    if not os.path.isfile(path):
        console.print(f"[yellow]Файл не найден: {path} — volume будет пропущен.[/yellow]")
        return None
    return path


def ask_compose_path() -> str | None:
    """Определяет путь к docker-compose.yml ноды до запуска блоков."""
    candidates = find_compose_candidates()
    if len(candidates) == 1:
        console.print(f"[green]Найден docker-compose ноды:[/green] {candidates[0]}")
        return candidates[0]
    if len(candidates) > 1:
        sel = questionary.select(
            "Найдено несколько docker-compose.yml — выберите файл ноды:",
            choices=[*candidates, "Указать вручную", "Пропустить"],
            style=CUSTOM_STYLE,
        ).ask()
        if sel is None or sel == "Пропустить":
            return None
        if sel == "Указать вручную":
            return _ask_compose_manual()
        return sel
    return _ask_compose_manual()


def patch_compose_volume(path: str) -> str:
    """Добавляет volume в нужный сервис, сохраняя форматирование и комментарии.
    Возвращает: 'added' | 'exists' | текст ошибки."""
    ensure("ruamel.yaml", "ruamel.yaml")
    from ruamel.yaml import YAML
    from ruamel.yaml.scalarstring import DoubleQuotedScalarString
    from ruamel.yaml.comments import CommentedSeq

    yaml = YAML()
    yaml.preserve_quotes = True
    yaml.indent(mapping=2, sequence=4, offset=2)

    with open(path, encoding="utf-8") as f:
        data = yaml.load(f)

    if not data or "services" not in data or not data["services"]:
        return "в файле нет секции services"

    services = data["services"]
    # Выбираем сервис: точное имя remnanode → единственный сервис → по подстроке
    if "remnanode" in services:
        names = ["remnanode"]
    elif len(services) == 1:
        names = [next(iter(services))]
    else:
        names = [n for n in services if "remna" in str(n).lower()] or list(services)

    changed = False
    already = False
    for name in names:
        svc = services.get(name)
        if svc is None:
            continue
        vols = svc.get("volumes")
        if vols is None:
            vols = CommentedSeq()
            svc["volumes"] = vols
        if any(str(v).strip().strip('"').strip("'") == REMNANODE_VOLUME for v in vols):
            already = True
            continue
        vols.append(DoubleQuotedScalarString(REMNANODE_VOLUME))
        changed = True

    if not changed:
        return "exists" if already else "сервис ноды не найден"

    with open(path, "w", encoding="utf-8") as f:
        yaml.dump(data, f)
    return "added"


def recreate_node(compose_path: str) -> None:
    """Пересоздаёт контейнер ноды, чтобы применился новый volume."""
    if subprocess.run(["docker", "compose", "version"],
                      capture_output=True).returncode == 0:
        cmd = ["docker", "compose", "-f", compose_path, "up", "-d", "--remove-orphans"]
    elif shutil.which("docker-compose"):
        cmd = ["docker-compose", "-f", compose_path, "up", "-d", "--remove-orphans"]
    else:
        console.print("[yellow]docker compose не найден — пересоздайте ноду вручную "
                      "для применения volume.[/yellow]")
        return
    console.print("[cyan]Пересоздаю контейнер ноды для применения volume…[/cyan]")
    run(cmd, check=False)


def block_remnanode_logs(compose_path: str | None) -> None:
    step("Логи remnanode: каталог + logrotate + docker volume")
    # 1. Каталог под логи
    os.makedirs("/var/log/remnanode", exist_ok=True)
    console.print("[green]✓ Каталог /var/log/remnanode готов[/green]")
    # 2. logrotate
    logrotate_conf = """/var/log/remnanode/*.log {
    su root root
    daily
    rotate 14
    maxsize 300M
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
}
"""
    with open("/etc/logrotate.d/remnanode", "w", encoding="utf-8") as f:
        f.write(logrotate_conf)
    console.print("[green]✓ /etc/logrotate.d/remnanode записан[/green]")
    # 3. Volume в docker-compose.yml ноды
    if not compose_path:
        console.print("[yellow]docker-compose.yml ноды не задан — volume не добавлен.[/yellow]")
        return
    result = patch_compose_volume(compose_path)
    if result == "exists":
        console.print(f"[green]✓ Volume уже присутствует в {compose_path}[/green]")
    elif result == "added":
        console.print(f"[green]✓ Volume добавлен в {compose_path}[/green]")
        recreate_node(compose_path)
    else:
        console.print(f"[yellow]Не удалось обновить {compose_path}: {result}[/yellow]")


