#!/usr/bin/env bash
#fail2ban + ufw + sysctl + cron
set -euo pipefail

# === Проверка прав ===
if [ "$(id -u)" -ne 0 ]; then
    echo "Скрипт нужно запускать от root (или через sudo)." >&2
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive

# === Пакеты ===
apt-get update
apt-get install -y fail2ban ufw unattended-upgrades
dpkg-reconfigure -f noninteractive unattended-upgrades

# === Fail2Ban ===
cat > /etc/fail2ban/jail.local << 'EOF'
[DEFAULT]
backend = systemd

[sshd]
enabled = true
port = ssh
filter = sshd
maxretry = 5
findtime = 600
bantime = 12h
EOF
systemctl enable --now fail2ban
systemctl restart fail2ban

# === UFW ===
ufw --force reset
ufw default deny incoming
ufw default allow outgoing
ufw limit ssh
ufw allow 80/tcp
ufw allow 443/tcp
ufw allow 8443/tcp
ufw allow 9999/tcp
ufw allow from 109.248.168.105 to any port 2222 proto tcp
ufw allow in on lo
ufw allow out on lo
ufw logging low
ufw --force enable

# === Загрузка модуля conntrack ===
modprobe nf_conntrack || true
echo 'nf_conntrack' > /etc/modules-load.d/nf_conntrack.conf
echo 'options nf_conntrack hashsize=262144' > /etc/modprobe.d/nf_conntrack.conf

# === Sysctl ===
cat > /etc/sysctl.d/99-vpn.conf << 'EOF'
# --- IPv6 / forwarding ---
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
net.ipv4.ip_forward = 1

# --- TCP congestion control + qdisc ---
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3

# --- Буферы сокетов (большие — для высокой пропускной способности VPN) ---
net.core.rmem_max = 67108864
net.core.wmem_max = 67108864
net.ipv4.tcp_rmem = 4096 1048576 33554432
net.ipv4.tcp_wmem = 4096 1048576 33554432

# --- Keepalive ---
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_keepalive_intvl = 15
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_fin_timeout = 15

# --- Очереди / бэклоги ---
net.core.netdev_max_backlog = 16384
net.core.somaxconn = 65535
net.ipv4.tcp_max_syn_backlog = 8192
net.ipv4.tcp_notsent_lowat = 16384

# --- Защита и переиспользование TCP ---
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_tw_reuse = 1

# --- Conntrack (требует загруженного модуля nf_conntrack) ---
net.netfilter.nf_conntrack_max = 1048576
net.netfilter.nf_conntrack_buckets = 262144
net.netfilter.nf_conntrack_tcp_timeout_established = 600
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 30
net.netfilter.nf_conntrack_tcp_timeout_close_wait = 30

# --- Память ---
vm.swappiness = 10
EOF
sysctl --system

# === Timezone и cron ===
timedatectl set-timezone Europe/Moscow

# Безопасное обновление crontab: вычищаем старые записи, добавляем новую.
CURRENT_CRON="$(crontab -l 2>/dev/null | grep -v -E 'remnanode|/sbin/reboot' || true)"
{
    if [ -n "$CURRENT_CRON" ]; then
        printf '%s\n' "$CURRENT_CRON"
    fi
    echo "0 4 * * * cd /opt/remnanode && /usr/bin/docker compose pull -q && /usr/bin/docker compose up -d --remove-orphans && /sbin/reboot"
} | crontab -

echo "=== Готово ==="
