def _install_tblocker_package() -> None:
    """Подключает репозиторий remna.dev и ставит пакет tblocker."""
    run(["apt-get", "install", "-y", "curl", "gnupg", "ca-certificates"])
    keyring  = "/usr/share/keyrings/openrepo-xray-tools.gpg"
    listfile = "/etc/apt/sources.list.d/openrepo-xray-tools.list"
    if not os.path.isfile(listfile):
        run("curl -fsSL https://repo.remna.dev/xray-tools/public.gpg "
            f"| gpg --yes --dearmor -o {keyring}", shell=True)
        with open(listfile, "w", encoding="utf-8") as f:
            f.write(f"deb [arch=any signed-by={keyring}] "
                    "https://repo.remna.dev/xray-tools/ stable main\n")
    run(["apt-get", "update"])
