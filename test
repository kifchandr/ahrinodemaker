TRAFFICGUARD_INSTALLER = (
    "https://raw.githubusercontent.com/DonMatteoVPN/TrafficGuard-auto/"
    "refs/heads/main/install-trafficguard.sh"
)


def block_trafficguard() -> None:
    step("TrafficGuard-auto: защита от сканеров и ботов")
    # curl нужен для загрузки установщика (пакеты установщик доставит сам)
    if shutil.which("curl") is None:
        run(["apt-get", "install", "-y", "curl"])
    # Установщик ставит пакеты через apt — дождёмся блокировки dpkg
    wait_for_apt_lock()
    # ВАЖНО: оригинальный установщик в самом конце запускает ИНТЕРАКТИВНОЕ меню
    # (`/opt/trafficguard-manager.sh monitor`, оно же `rknpidor`) и читает ввод
    # из /dev/tty — это намертво заблокировало бы наш скрипт. Вырезаем ровно эту
    # строку через sed; вся установка при этом отрабатывает неинтерактивно.
    run(
        "set -o pipefail; curl -fsSL "
        f"{TRAFFICGUARD_INSTALLER} "
        "| sed '/trafficguard-manager\\.sh monitor/d' | bash",
        shell=True, check=True,
    )
    console.print("[green]✓ TrafficGuard-auto установлен. "
                  "Меню мониторинга: [bold]rknpidor[/bold][/green]")


