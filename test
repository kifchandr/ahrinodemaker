def main() -> None:
    if not reattach_tty():
        console.print(
            "[red]Нет доступа к терминалу для интерактивного выбора.[/red]\n"
            "Запустите так: [bold]curl -fsSL <URL> | sudo python3[/bold] "
            "в обычной консоли сервера."
        )
        return

    console.print()
    console.print(Panel(
        "[bold]Интерактивная настройка и защита VPN-сервера[/bold]\n"
        "[dim]fail2ban · ufw · sysctl (BBR) · conntrack · cron · "
        "логи remnanode · торренты · TrafficGuard[/dim]",
        title=f"[bold cyan]{APP_NAME}[/bold cyan]",
        subtitle="[dim]требуются права root[/dim]",
        border_style="cyan",
        box=box.DOUBLE,
        padding=(1, 4),
    ))
    console.print()

    # 1. Проверяем, что уже настроено на сервере, — такие блоки по умолчанию
    #    будут БЕЗ галочки (повторно выполнять не нужно). При желании их можно
    #    отметить вручную — тогда блок отработает заново.
    console.print("[dim]Проверяю текущее состояние сервера…[/dim]")
    applied = detect_applied()
    if any(applied.values()):
        done = ", ".join(label for key, label, _ in BLOCKS if applied[key])
        console.print(f"[green]Уже настроено (галочки сняты):[/green] {done}")
    console.print()

    # 2. Выбор блоков галочками (уже настроенные — сняты по умолчанию)
    choices = [
        questionary.Choice(
            title=label + ("   [уже настроено]" if applied[key] else ""),
            value=key,
            checked=not applied[key],
        )
        for key, label, _ in BLOCKS
    ]
    selected = questionary.checkbox(
        "Отметьте блоки для выполнения (Space — выбрать, Enter — подтвердить):",
        choices=choices,
        style=CUSTOM_STYLE,
    ).ask()
    if not selected:
        console.print("[yellow]Ничего не выбрано — выход.[/yellow]")
        return

    # 2. Расписание перезагрузки — только если выбран блок cron
    reboot_schedule = "daily"
    if "time_cron" in selected:
        reboot_schedule = ask_reboot_schedule()

    # 3. Доп. порты — только если выбран блок UFW
    extra_ports: list[str] = []
    if "ufw" in selected:
        extra_ports = ask_extra_ports()

    # 4. Путь к docker-compose ноды — только если выбран блок логов remnanode
    compose_path: str | None = None
    if "remnanode_logs" in selected:
        compose_path = ask_compose_path()

    # 5. Сводка и запуск через Enter
    schedule_human = ("ежедневно в 03:00" if reboot_schedule == "daily"
                      else "по понедельникам в 03:00")

    table = Table(title="Будет выполнено", box=box.ROUNDED, border_style="cyan",
                  show_header=False, title_style="bold cyan", padding=(0, 1))
    table.add_column(justify="center", width=3)
    table.add_column()
    for key, label, _ in BLOCKS:
        if key in selected:
            table.add_row("[green]✓[/green]", label)
        else:
            table.add_row("[dim]–[/dim]", f"[dim]{label}[/dim]")
    console.print(table)

    if "time_cron" in selected:
        console.print(f"[bold]Перезагрузка:[/bold] {schedule_human} (МСК)")
    if extra_ports:
        console.print(f"[bold]Доп. порты UFW:[/bold] {', '.join(extra_ports)}")
    if "remnanode_logs" in selected:
        if compose_path:
            console.print(f"[bold]docker-compose ноды:[/bold] {compose_path}")
        else:
            console.print("[bold]docker-compose ноды:[/bold] [dim]не задан (volume будет пропущен)[/dim]")

    answer = questionary.text(
        "Нажмите Enter для запуска (Ctrl+C — отмена)", default="",
        style=CUSTOM_STYLE,
    ).ask()
    if answer is None:  # Ctrl+C
        console.print("[yellow]Отменено пользователем.[/yellow]")
        return

    # 6. Выполнение в исходном порядке
    failures = []

    # Сначала — обновление системы (после того как пользователь ответил
    # на все вопросы и подтвердил запуск).
    try:
        block_system_upgrade()
    except subprocess.CalledProcessError as exc:
        failures.append(("Обновление системы (apt update && apt upgrade)", exc))
        console.print(f"[red]✗ Ошибка при обновлении системы — продолжаю дальше: {exc}[/red]")

    for key, label, func in BLOCKS:
        if key not in selected:
            continue
        try:
            if key == "ufw":
                func(extra_ports)
            elif key == "remnanode_logs":
                func(compose_path)
            elif key == "time_cron":
                func(reboot_schedule)
            else:
                func()
        except subprocess.CalledProcessError as exc:
            failures.append((label, exc))
            console.print(f"[red]✗ Ошибка в блоке «{label}» — продолжаю дальше: {exc}[/red]")

    if failures:
        console.print(Panel.fit(
            "\n".join(f"• {name}" for name, _ in failures),
            title="[red]Завершено с ошибками[/red]", border_style="red",
        ))
    else:
        console.print(Panel.fit("[bold green]=== Готово ===[/bold green]",
                                border_style="green"))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        console.print("\n[yellow]Прервано пользователем.[/yellow]")
        sys.exit(130)
