def _crontab_replace_block(marker: str, lines: list[str]) -> None:
    """Заменяет в crontab root блок, помеченный marker, сохраняя все остальные
    задачи. lines пустой — блок просто удаляется."""
    if shutil.which("crontab") is None:
        raise RuntimeError("команда crontab не найдена (нужен пакет cron)")

    res = probe(["crontab", "-l"])
    existing = res.stdout.splitlines() if res.returncode == 0 else []

    kept: list[str] = []
    skip_next = False
    for ln in existing:
        if ln.strip() == marker:
            skip_next = True      # следующая строка — задача этого блока
            continue
        if skip_next:
            skip_next = False
            continue
        kept.append(ln)

    while kept and not kept[-1].strip():
        kept.pop()
    if lines:
        if kept:
            kept.append("")
        kept.append(marker)
        kept.extend(lines)

    new_cron = "\n".join(kept).strip("\n")
    run(["crontab", "-"], input_text=new_cron + "\n" if new_cron else "\n")


def _gdrive_schedule(folder_id: str, days: str) -> None:
    hour = questionary.text(
        "Час запуска очистки (0–23), по умолчанию 4:", default="4",
        style=CUSTOM_STYLE).ask()
    if hour is None:
        return
    hour = hour.strip() or "4"
    if not hour.isdigit() or not 0 <= int(hour) <= 23:
        console.print("[red]Час должен быть числом от 0 до 23.[/red]")
        return

    line = (f"0 {int(hour)} * * * FOLDER_ID={folder_id} DAYS_OLD={days} "
            f"DRY_RUN=false {GDRIVE_CLEANUP_PATH} >/dev/null 2>&1")
    _crontab_replace_block(GDRIVE_CRON_MARKER, [line])
    console.print(f"[green]✓ Очистка добавлена в cron: ежедневно в "
                  f"{int(hour):02d}:00 ({TIMEZONE})[/green]")


def _gdrive_current_schedule() -> str | None:
    res = probe(["crontab", "-l"])
    if res.returncode != 0:
        return None
    for line in res.stdout.splitlines():
        if GDRIVE_CLEANUP_PATH in line and not line.strip().startswith("#"):
            m = re.match(r"^\s*(\d+)\s+(\d+)\s", line)
            if m:
                return f"ежедневно в {int(m.group(2)):02d}:{int(m.group(1)):02d}"
            return "задано"
    return None


