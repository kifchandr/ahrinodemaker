def menu_remnawave_node() -> None:
    # Краткая сводка о состоянии сервера
    console.print(f"[bold]Свободно на диске:[/bold] {disk_free_info()}")
    console.print(f"[bold]Текущее расписание перезагрузки:[/bold] "
                  f"{current_reboot_schedule()}")

    # Состояние remnanode (проверка версии в реестре может занять пару секунд)
    console.print("[dim]Проверяю версию remnanode…[/dim]")
    try:
        node_status, node_path, node_image = node_update_status()
    except OSError as exc:
        # Проверка версии — вспомогательная; её сбой не должен мешать меню.
        console.print(f"[dim]Не удалось определить состояние ноды: {exc}[/dim]")
        node_status, node_path, node_image = "absent", None, None
    node_note = {
        "update":  "[yellow]доступно обновление[/yellow]",
        "latest":  "[green]установлена последняя версия[/green]",
        "unknown": "[dim]не удалось проверить версию (реестр недоступен)[/dim]",
    }.get(node_status)
    if node_note:
        suffix = f" [dim]({node_image})[/dim]" if node_image else ""
        console.print(f"[bold]remnanode:[/bold] {node_note}{suffix}")
    console.print()

    # 1. Проверяем, что уже настроено на сервере, — такие блоки по умолчанию
    #    будут БЕЗ галочки (повторно выполнять не нужно). При желании их можно
    #    отметить вручную — тогда блок отработает заново.
    console.print("[dim]Проверяю текущее состояние сервера…[/dim]")
    applied = detect_applied()
    console.print()

    # 2. Выбор блоков галочками. Уже настроенные блоки идут без галочки.
    #    Пункт обновления ноды показываем только если нода установлена и её
    #    версия не последняя (или версию не удалось проверить).
    shown_keys: list[str] = []
    choices = []
    for key, label, _ in BLOCKS:
        if key == "node_update":
            if node_status == "update":
                choices.append(questionary.Choice(label, value=key, checked=True))
                shown_keys.append(key)
            elif node_status == "unknown":
                choices.append(questionary.Choice(
                    label + "   [версию проверить не удалось]",
                    value=key, checked=False))
                shown_keys.append(key)
            # 'absent' и 'latest' — пункт не показываем
            continue
        is_applied = applied.get(key, False)
        choices.append(questionary.Choice(
            title=label + ("   [уже настроено]" if is_applied else ""),
            value=key,
            checked=not is_applied,
        ))
        shown_keys.append(key)

    selected = questionary.checkbox(
        "Отметьте блоки для выполнения (Space — выбрать, Enter — подтвердить):",
        choices=choices,
        style=CUSTOM_STYLE,
    ).ask()
    if not selected:
        console.print("[yellow]Ничего не выбрано — возврат в главное меню.[/yellow]")
        return

    # 3. Расписание перезагрузки — только если выбран блок cron
    reboot_schedule = "daily"
    if "time_cron" in selected:
        reboot_schedule = ask_reboot_schedule()

    # 3. Доп. порты — только если выбран блок UFW
    extra_ports: list[str] = []
    if "ufw" in selected:
        extra_ports = ask_extra_ports()

    # 4. Путь к docker-compose ноды — только если выбран блок логов remnanode
    compose_path: str | None = None
    if "remnanode_logs" in selected:
        compose_path = ask_compose_path()

    # 5. Сводка и запуск через Enter
    will_upgrade = bool(set(selected) & INSTALLS_PACKAGES)
    schedule_human = ("ежедневно в 03:00" if reboot_schedule == "daily"
                      else "по понедельникам в 03:00")

    table = Table(title="Будет выполнено", box=box.ROUNDED, border_style="cyan",
                  show_header=False, title_style="bold cyan", padding=(0, 1))
    table.add_column(justify="center", width=3)
    table.add_column()
    for key, label, _ in BLOCKS:
        if key not in shown_keys:
            continue
        if key in selected:
            table.add_row("[green]✓[/green]", label)
        else:
            table.add_row("[dim]–[/dim]", f"[dim]{label}[/dim]")
    console.print(table)

    if will_upgrade:
        console.print("[bold]Обновление пакетов:[/bold] да (apt update && upgrade)")
    if "time_cron" in selected:
        console.print(f"[bold]Перезагрузка:[/bold] {schedule_human} (МСК)")
    if extra_ports:
        console.print(f"[bold]Доп. порты UFW:[/bold] {', '.join(extra_ports)}")
    if "remnanode_logs" in selected:
        if compose_path:
            console.print(f"[bold]docker-compose ноды:[/bold] {compose_path}")
        else:
            console.print("[bold]docker-compose ноды:[/bold] [dim]не задан (volume будет пропущен)[/dim]")

    answer = questionary.text(
        "Нажмите Enter для запуска (Ctrl+C — отмена)", default="",
        style=CUSTOM_STYLE,
    ).ask()
    if answer is None:  # Ctrl+C
        console.print("[yellow]Отменено — возврат в главное меню.[/yellow]")
        return

    # 6. Выполнение в исходном порядке
    failures = []

    # Обновление системы — только если среди выбранных блоков есть те, что
    # реально устанавливают пакеты. Иначе (например, выбран только часовой
    # пояс) обновлять пакеты незачем и мы его пропускаем.
    # Ловим широко: помимо CalledProcessError блок может отвалиться на
    # FileNotFoundError (нет бинарника), PermissionError/OSError (запись конфига)
    # или RuntimeError (наши собственные проверки). Раньше любое из них
    # обрывало весь прогон трейсбеком вместо «продолжаю дальше».
    BLOCK_ERRORS = (subprocess.CalledProcessError, OSError, RuntimeError, ValueError)

    if will_upgrade:
        try:
            block_system_upgrade()
        except BLOCK_ERRORS as exc:
            failures.append(("Обновление системы (apt update && apt upgrade)", exc))
            console.print(f"[red]✗ Ошибка при обновлении системы — продолжаю дальше: {exc}[/red]")

    for key, label, func in BLOCKS:
        if key not in selected:
            continue
        try:
            if key == "ufw":
                func(extra_ports)
            elif key == "remnanode_logs":
                func(compose_path)
            elif key == "node_update":
                func(node_path)
            elif key == "time_cron":
                func(reboot_schedule)
            else:
                func()
        except BLOCK_ERRORS as exc:
            failures.append((label, exc))
            console.print(f"[red]✗ Ошибка в блоке «{label}» — продолжаю дальше: {exc}[/red]")

    if failures:
        console.print(Panel.fit(
            "\n".join(f"• {name}\n  [dim]{exc}[/dim]" for name, exc in failures),
            title="[red]Завершено с ошибками[/red]", border_style="red",
        ))
    else:
        console.print(Panel.fit("[bold green]=== Готово ===[/bold green]",
                                border_style="green"))


