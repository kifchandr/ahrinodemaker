        console.print(f"[bold]Перезагрузка:[/bold] {schedule_human} (МСК)")
    if extra_ports:
        console.print(f"[bold]Доп. порты UFW:[/bold] {', '.join(extra_ports)}")
    if node_params:
        # SECRET_KEY не печатаем целиком — он уходит в лог терминала и в скроллбек
        console.print(f"[bold]Установка ноды:[/bold] порт {node_params[1]}, "
                      f"SECRET_KEY указан ([dim]…{node_params[0][-4:]}[/dim])")
    if "remnanode_logs" in selected:
        if compose_path:
            console.print(f"[bold]docker-compose ноды:[/bold] {compose_path}")
        else:
            console.print("[bold]docker-compose ноды:[/bold] [dim]не задан (volume будет пропущен)[/dim]")
            if "torrent" in selected:
                # tblocker следит за /var/log/remnanode/access.log на хосте;
                # без volume этот файл не появится и блокировка не заработает.
                console.print("[yellow]  Внимание: выбран блок блокировки "
                              "торрентов, но без volume tblocker не увидит "
                              "access.log и работать не будет.[/yellow]")

    answer = questionary.text(
        "Нажмите Enter для запуска (Ctrl+C — отмена)", default="",
        style=CUSTOM_STYLE,
    ).ask()
    if answer is None:  # Ctrl+C
        console.print("[yellow]Отменено — возврат в главное меню.[/yellow]")
        return

    # 6. Выполнение в исходном порядке
    failures = []

    # Обновление системы — только если среди выбранных блоков есть те, что
    # реально устанавливают пакеты. Иначе (например, выбран только часовой
    # пояс) обновлять пакеты незачем и мы его пропускаем.
    # Ловим широко: помимо CalledProcessError блок может отвалиться на
    # FileNotFoundError (нет бинарника), PermissionError/OSError (запись конфига)
    # или RuntimeError (наши собственные проверки). Раньше любое из них
    # обрывало весь прогон трейсбеком вместо «продолжаю дальше».
    BLOCK_ERRORS = (subprocess.CalledProcessError, OSError, RuntimeError, ValueError)

    if will_upgrade:
        try:
            block_system_upgrade()
        except BLOCK_ERRORS as exc:
            failures.append(("Обновление системы (apt update && apt upgrade)", exc))
            console.print(f"[red]✗ Ошибка при обновлении системы — продолжаю дальше: {exc}[/red]")

    for key, label, func in BLOCKS:
        if key not in selected:
            continue
        try:
            if key == "ufw":
                func(extra_ports)
            elif key == "node_install":
                func(node_params)
            elif key == "hysteria":
                func(hysteria_params)
            elif key == "warp":
                func(warp_license)
            elif key == "remnanode_logs":
                func(compose_path)
            elif key == "node_update":
                func(node_path)
            elif key == "time_cron":
                func(reboot_schedule)
            else:
                func()
        except BLOCK_ERRORS as exc:
            failures.append((label, exc))
            console.print(f"[red]✗ Ошибка в блоке «{label}» — продолжаю дальше: {exc}[/red]")

    if failures:
        console.print(Panel.fit(
            "\n".join(f"• {name}\n  [dim]{exc}[/dim]" for name, exc in failures),
            title="[red]Завершено с ошибками[/red]", border_style="red",
        ))
    else:
        console.print(Panel.fit("[bold green]=== Готово ===[/bold green]",
                                border_style="green"))


