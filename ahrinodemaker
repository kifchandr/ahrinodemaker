# Блокировка торрентов: tblocker + egress-фильтр (nft) + справка панели
# ------------------------------------------------------------------ #
# Единый источник правды по портам: раньше список дублировался в bash-скрипте
# и в справке для панели, и они могли разъехаться.
TORRENT_PORTS = [6881, 6882, 6883, 6884, 6885, 6886, 6887, 6888, 6889, 51413]

EGRESS_SCRIPT = r'''#!/usr/bin/env bash
set -euo pipefail
PORTS=(__PORTS__)
apply() {
  local f=$1 t=$2 s=$3
  nft list table "$f" "$t" >/dev/null 2>&1 || return 0
  local e=()
  for p in "${PORTS[@]}"; do e+=("tcp . $p" "udp . $p"); done
  # Элементы склеиваем через ", " БЕЗ хвостовой запятой: `{ …, }` отвергается
  # разбором nft в старых версиях, и правило молча не применялось.
  local list
  printf -v list '%s, ' "${e[@]}"
  list=${list%, }
  if ! nft add element "$f" "$t" "$s" "{ $list }"; then
    # Раньше ошибка гасилась `2>/dev/null || true` — фильтр не работал,
    # и об этом никто не узнавал.
    echo "nft: не удалось добавить элементы в $f $t $s" >&2
    return 1
  fi
}
rc=0
apply ip remnanode egress-filter-port || rc=1
apply ip6 remnanode6 egress-filter-port6 || rc=1
exit $rc
'''.replace("__PORTS__", " ".join(str(p) for p in TORRENT_PORTS))

