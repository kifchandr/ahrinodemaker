# --------------------------------------------------------------- #
# Удаление старых бэкапов Google Drive
# --------------------------------------------------------------- #
GDRIVE_DEFAULT_FOLDER_ID = "1zcpGqw_jAGiqDBIlWDfGbcLjrSjuTBPS"
GDRIVE_DEFAULT_DAYS = "30"

GDRIVE_CLEANUP_SCRIPT = r'''#!/usr/bin/env bash
#
# gdrive-cleanup.sh
#
# Удаляет (перемещает в корзину) файлы старше N дней в указанной папке
# Google Drive. Использует те же OAuth-credentials (GD_CLIENT_ID /
# GD_CLIENT_SECRET / GD_REFRESH_TOKEN), что и distillium/remnawave-backup-restore,
# и по умолчанию читает их из его config.env.
#
# Требования: bash, curl, jq
#
set -euo pipefail

# ---------------------------------------------------------------------------
# НАСТРОЙКИ
# ---------------------------------------------------------------------------

# Файл конфигурации backup-restore.sh, откуда берём GD_CLIENT_ID/SECRET/TOKEN.
# Если файла нет или переменных в нём нет — задайте их здесь руками.
CONFIG_FILE="${CONFIG_FILE:-/opt/rw-backup-restore/config.env}"

# ID папки Google Drive, из ссылки
# https://drive.google.com/drive/folders/<FOLDER_ID>
FOLDER_ID="${FOLDER_ID:-__FOLDER_ID__}"

# Сколько дней хранить файлы (более старые будут удалены)
DAYS_OLD="${DAYS_OLD:-__DAYS_OLD__}"

# true  -> ничего не удалять, только показать, что было бы удалено
# false -> реально перемещать файлы в корзину
DRY_RUN="${DRY_RUN:-false}"

# Файл лога (можно оставить пустым, тогда лог только в stderr)
LOG_FILE="${LOG_FILE:-/opt/rw-backup-restore/gdrive-cleanup.log}"

# ---------------------------------------------------------------------------

log() {
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    # Пишем в stderr, а не в stdout: get_access_token возвращает токен через
    # stdout внутри $( ), и любое сообщение отсюда попало бы в значение
    # переменной вместо экрана — при ошибке авторизации она молча «терялась».
    echo "$msg" >&2
    if [[ -n "$LOG_FILE" ]]; then
        mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
        echo "$msg" >> "$LOG_FILE"
    fi
}

fail() {
    log "ОШИБКА: $1"
    exit 1
}

command -v curl >/dev/null 2>&1 || fail "curl не установлен"
command -v jq   >/dev/null 2>&1 || fail "jq не установлен"

# Подхватываем credentials из config.env backup-restore.sh, если он есть
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

: "${GD_CLIENT_ID:?GD_CLIENT_ID не задан (нет в $CONFIG_FILE и не передан вручную)}"
: "${GD_CLIENT_SECRET:?GD_CLIENT_SECRET не задан}"
: "${GD_REFRESH_TOKEN:?GD_REFRESH_TOKEN не задан}"

get_access_token() {
    local response
    response=$(curl -s -X POST https://oauth2.googleapis.com/token \
        -d client_id="$GD_CLIENT_ID" \
        -d client_secret="$GD_CLIENT_SECRET" \
        -d refresh_token="$GD_REFRESH_TOKEN" \
        -d grant_type="refresh_token")

    local token
    token=$(echo "$response" | jq -r '.access_token // empty')

    if [[ -z "$token" ]]; then
        local err
        err=$(echo "$response" | jq -r '.error_description // .error // "unknown error"')
        fail "не удалось получить access token: $err"
    fi
    echo "$token"
}

main() {
    log "Старт очистки папки Google Drive $FOLDER_ID (старше ${DAYS_OLD} дн., DRY_RUN=${DRY_RUN})"

    local access_token
    access_token=$(get_access_token)

    # cutoff в формате RFC3339 UTC, совместимом с Drive API (modifiedTime < cutoff)
    local cutoff
    if date -u -d "-${DAYS_OLD} days" +%Y-%m-%dT%H:%M:%SZ >/dev/null 2>&1; then
        cutoff=$(date -u -d "-${DAYS_OLD} days" +%Y-%m-%dT%H:%M:%SZ)          # GNU date (Linux)
    else
        cutoff=$(date -u -v-"${DAYS_OLD}"d +%Y-%m-%dT%H:%M:%SZ)               # BSD/macOS date
    fi

    log "Порог: файлы с modifiedTime < $cutoff будут удалены"

    local page_token=""
    local total_deleted=0
    local total_found=0

    while true; do
        local query
        query="'${FOLDER_ID}' in parents and trashed = false and modifiedTime < '${cutoff}'"

        local url="https://www.googleapis.com/drive/v3/files"
        local args=(
            -sG "$url"
            --data-urlencode "q=${query}"
            --data-urlencode "fields=nextPageToken,files(id,name,modifiedTime,size)"
            --data-urlencode "pageSize=1000"
            --data-urlencode "spaces=drive"
            -H "Authorization: Bearer ${access_token}"
        )
        if [[ -n "$page_token" ]]; then
            args+=(--data-urlencode "pageToken=${page_token}")
        fi

        local list_response
        list_response=$(curl "${args[@]}")

        local list_error
        list_error=$(echo "$list_response" | jq -r '.error.message // empty')
        if [[ -n "$list_error" ]]; then
            fail "ошибка запроса списка файлов: $list_error"
        fi

        local count
        count=$(echo "$list_response" | jq '.files | length')
        total_found=$((total_found + count))

        if [[ "$count" -gt 0 ]]; then
            while IFS=$'\t' read -r file_id file_name modified_time; do
                [[ -z "$file_id" ]] && continue
                if [[ "$DRY_RUN" == "true" ]]; then
                    log "[DRY_RUN] удалил бы: ${file_name} (изменён ${modified_time}, id=${file_id})"
                else
                    local del_response
                    del_response=$(curl -s -X PATCH \
                        "https://www.googleapis.com/drive/v3/files/${file_id}?fields=id,trashed" \
                        -H "Authorization: Bearer ${access_token}" \
                        -H "Content-Type: application/json" \
                        -d '{"trashed": true}')

                    local del_error
                    del_error=$(echo "$del_response" | jq -r '.error.message // empty')
                    if [[ -n "$del_error" ]]; then
                        log "НЕ УДАЛОСЬ удалить ${file_name} (id=${file_id}): ${del_error}"
                    else
                        log "Удалён (в корзину): ${file_name} (изменён ${modified_time}, id=${file_id})"
                        total_deleted=$((total_deleted + 1))
                    fi
                fi
            done < <(echo "$list_response" | jq -r '.files[] | [.id, .name, .modifiedTime] | @tsv')
        fi

        page_token=$(echo "$list_response" | jq -r '.nextPageToken // empty')
        [[ -z "$page_token" ]] && break
    done

    if [[ "$DRY_RUN" == "true" ]]; then
        log "Готово (DRY_RUN). Найдено файлов старше ${DAYS_OLD} дн.: ${total_found}"
    else
        log "Готово. Найдено: ${total_found}, удалено (в корзину): ${total_deleted}"
    fi
}

main "$@"
'''


