def _install_tblocker_package() -> None:
    """Подключает репозиторий remna.dev и ставит пакет tblocker."""
    run(["apt-get", "install", "-y", "curl", "gnupg", "ca-certificates"])
    keyring  = "/usr/share/keyrings/openrepo-xray-tools.gpg"
    listfile = "/etc/apt/sources.list.d/openrepo-xray-tools.list"

    # Ключ переустанавливаем, если его нет или он пустой: раньше сбой curl
    # приводил к нулевому keyring (gpg на пустом входе возвращал 0), после чего
    # apt-get update падал навсегда — listfile уже существовал и ветка
    # пересоздания ключа больше не выполнялась.
    key_ok = os.path.isfile(keyring) and os.path.getsize(keyring) > 0
    if not key_ok:
        # set -o pipefail обязателен: без него код возврата берётся от gpg
        run("set -o pipefail; curl -fsSL https://repo.remna.dev/xray-tools/public.gpg "
            f"| gpg --yes --dearmor -o {shlex.quote(keyring)}", shell=True)
        if not (os.path.isfile(keyring) and os.path.getsize(keyring) > 0):
            raise RuntimeError("не удалось загрузить GPG-ключ репозитория remna.dev")

    # arch=any не является валидной архитектурой для apt — подставляем реальную
    arch = probe(["dpkg", "--print-architecture"]).stdout.strip() or "amd64"
    write_file(listfile,
               f"deb [arch={arch} signed-by={keyring}] "
               "https://repo.remna.dev/xray-tools/ stable main\n")

    run(["apt-get", "update"])
