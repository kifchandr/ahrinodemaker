def _pkg_installed(pkg: str) -> bool:
    # dpkg -s / dpkg -l возвращают 0 и для состояния "rc" (пакет удалён,
    # конфиги остались), поэтому сверяем именно статус установки.
    r = probe(["dpkg-query", "-W", "-f=${db:Status-Status}", pkg])
    return r.returncode == 0 and r.stdout.strip() == "installed"


def _detect_packages() -> bool:
    return all(_pkg_installed(p) for p in ("fail2ban", "ufw", "unattended-upgrades", "cron"))


def _detect_fail2ban() -> bool:
    # Наличие файла ещё не значит, что служба работает: при неверном backend
    # fail2ban стартует и сразу падает, а блок считался бы «уже настроенным».
    return (os.path.isfile("/etc/fail2ban/jail.local")
            and probe(["systemctl", "is-active", "--quiet", "fail2ban"]).returncode == 0)


def _detect_ufw() -> bool:
    res = probe(["ufw", "status"])
    return res.returncode == 0 and "Status: active" in res.stdout


def _detect_network() -> bool:
    return os.path.isfile("/etc/sysctl.d/99-vpn.conf")


def _detect_time_cron() -> bool:
    tz = probe(["timedatectl", "show", "-p", "Timezone", "--value"])
    tz_ok = tz.returncode == 0 and tz.stdout.strip() == TIMEZONE
    cr = probe(["crontab", "-l"])
    cron_ok = cr.returncode == 0 and re.search(
        r"(?m)^\s*0\s+3\s+\*\s+\*\s+[*1]\s+.*?/sbin/reboot\b", cr.stdout) is not None
    return tz_ok and cron_ok


def _detect_remnanode_logs() -> bool:
    return (os.path.isfile("/etc/logrotate.d/remnanode")
            and os.path.isdir("/var/log/remnanode"))


def _detect_hysteria() -> bool:
    if not (os.path.isfile(HYSTERIA_CERT) and os.path.isfile(HYSTERIA_KEY)):
        return False
    cr = probe(["crontab", "-l"])
    return cr.returncode == 0 and HYSTERIA_CERT in cr.stdout


def _detect_warp() -> bool:
    r = probe(["docker", "inspect", "-f", "{{.State.Running}}", WARP_CONTAINER])
    return r.returncode == 0 and r.stdout.strip() == "true"


def _detect_torrent() -> bool:
    return _pkg_installed("tblocker") and os.path.isfile("/opt/tblocker/config.yaml")


def _detect_trafficguard() -> bool:
