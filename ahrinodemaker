# Установка ноды (docker + docker-compose.yml + запуск контейнера)
# ------------------------------------------------------------------ #
NODE_COMPOSE_PATH = f"{INSTALL_DIR}/docker-compose.yml"
NODE_DEFAULT_PORT = "2222"

NODE_COMPOSE_TEMPLATE = """services:
  remnanode:
    container_name: remnanode
    hostname: remnanode
    image: remnawave/node:latest
    network_mode: host
    restart: always
    cap_add:
      - NET_ADMIN
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
    environment:
      - NODE_PORT=__PORT__
      - SECRET_KEY=__SECRET__
    volumes:
      - "__LOG_VOLUME__"
"""


def prepare_node_logs() -> None:
    """Создаёт каталог и файлы логов ноды на хосте.

    Без существующих файлов tblocker не за чем следить, а logrotate нечего
    ротировать: xray создаёт их сам только когда в панели включено логирование,
    и до первого запроса каталог остаётся пустым."""
    os.makedirs(NODE_LOG_DIR, exist_ok=True)
    created = []
    for name in NODE_LOG_FILES:
        path = os.path.join(NODE_LOG_DIR, name)
        if os.path.exists(path):
            continue
        # Режим "a", а не "w": существующий лог не должен обнуляться, даже
        # если проверка выше когда-нибудь окажется гонкой.
        with open(path, "a", encoding="utf-8"):
            pass
        os.chmod(path, 0o644)
        created.append(name)
    if created:
        console.print(f"[green]✓ Созданы файлы логов: "
                      f"{', '.join(created)} в {NODE_LOG_DIR}[/green]")
    else:
        console.print(f"[green]✓ Файлы логов уже есть в {NODE_LOG_DIR}[/green]")


def _ensure_docker() -> None:
    """Ставит Docker вместе с плагином compose, если его нет."""
    if shutil.which("docker") and probe(["docker", "compose", "version"]).returncode == 0:
        console.print("[green]✓ Docker уже установлен[/green]")
        return

    console.print("[cyan]Устанавливаю Docker…[/cyan]")
    ensure_packages("curl", "ca-certificates")
    # Официальный установщик Docker. Единственная внешняя загрузка в этом
    # блоке: раскладку репозиториев под каждый дистрибутив он делает сам.
    with tempfile.TemporaryDirectory(prefix="get-docker-") as tmpdir:
        script = os.path.join(tmpdir, "get-docker.sh")
        _download("https://get.docker.com", script, timeout=60)
        run(["sh", script])

    run(["systemctl", "enable", "--now", "docker"], check=False)
    if not shutil.which("docker"):
        raise RuntimeError("Docker не установился — проверьте вывод выше")
    if probe(["docker", "compose", "version"]).returncode != 0:
        raise RuntimeError("Docker установлен, но плагин `docker compose` "
                           "недоступен — обновление и запуск ноды невозможны")
    console.print("[green]✓ Docker установлен[/green]")


def block_node_install(params: tuple[str, str] | None = None) -> None:
    step("Установка Remnawave Node")

    if params is None:
        console.print("[yellow]Не заданы SECRET_KEY и порт — установка "
                      "пропущена.[/yellow]")
        return
    secret_key, node_port = params

    # Подстраховка: пункт показывается только когда ноды нет, но за время
    # работы скрипта её мог поставить кто-то ещё. Чужой конфиг не перезаписываем.
    if os.path.isfile(NODE_COMPOSE_PATH):
        console.print(f"[yellow]{NODE_COMPOSE_PATH} уже существует — установка "
                      "пропущена, чтобы не затереть рабочую конфигурацию.[/yellow]")
        return

    _ensure_docker()

    # Каталог и файлы логов готовим ДО старта контейнера: если примонтировать
    # несуществующий путь, Docker создаст на хосте каталог вместо файла.
    prepare_node_logs()
    write_logrotate_config()

    compose = (NODE_COMPOSE_TEMPLATE
               .replace("__PORT__", node_port)
               .replace("__SECRET__", secret_key)
               .replace("__LOG_VOLUME__", REMNANODE_VOLUME))
    # 0600: в файле лежит SECRET_KEY панели
    write_file(NODE_COMPOSE_PATH, compose, mode=0o600)
    console.print(f"[green]✓ Конфигурация записана: {NODE_COMPOSE_PATH}[/green]")

    base = compose_base(NODE_COMPOSE_PATH)
    if base is None:
        raise RuntimeError("docker compose недоступен — контейнер не запущен")
    run(base + ["pull"])
    run(base + ["up", "-d", "--remove-orphans"])

    running = probe(["docker", "inspect", "-f", "{{.State.Running}}", "remnanode"])
    if running.stdout.strip() == "true":
        console.print(f"[green]✓ Нода запущена на порту {node_port}[/green]")
    else:
        console.print("[yellow]Контейнер remnanode не в состоянии running. "
                      "Проверьте: docker logs remnanode[/yellow]")

    console.print("[bold]Не забудьте:[/bold] открыть порт "
                  f"{node_port} для адреса панели (блок «Настройка UFW» делает "
                  "это для порта 2222).")


def ask_node_install_params() -> tuple[str, str] | None:
    """Спрашивает SECRET_KEY и порт до начала выполнения — как и остальные
    параметры, чтобы установка дальше шла без вопросов."""
    secret = questionary.text(
        "SECRET_KEY ноды (скопируйте из панели Remnawave):",
        default="", style=CUSTOM_STYLE).ask()
    if secret is None or not secret.strip():
        console.print("[yellow]SECRET_KEY не задан — установка ноды будет "
                      "пропущена.[/yellow]")
        return None
    secret = secret.strip()

    port = questionary.text(
        f"Порт ноды (Enter — {NODE_DEFAULT_PORT}):",
        default=NODE_DEFAULT_PORT, style=CUSTOM_STYLE).ask()
    if port is None:
        return None
    port = port.strip() or NODE_DEFAULT_PORT
    if not port.isdigit() or not 1 <= int(port) <= 65535:
        console.print(f"[red]Некорректный порт «{port}» — установка ноды "
                      "пропущена.[/red]")
        return None
    return (secret, port)


