def _human_size(n: int) -> str:
    gb = n / (1024 ** 3)
    if gb >= 1:
        return f"{gb:.1f} ГБ"
    return f"{n / (1024 ** 2):.0f} МБ"


def disk_free_info(path: str = "/") -> str:
    try:
        total, _used, free = shutil.disk_usage(path)
    except OSError:
        return "не удалось определить"
    pct = (free / total * 100) if total else 0
    text = f"{_human_size(free)} свободно из {_human_size(total)} ({pct:.0f}%)"
    # Меньше 20% свободного места — предупреждаем красным
    return f"[red]{text}[/red]" if pct < 20 else text


def current_reboot_schedule() -> str:
    """Читает текущее расписание автоперезагрузки из crontab root."""
    cr = probe(["crontab", "-l"])
    if cr.returncode != 0:
        return "не настроено"
    for line in cr.stdout.splitlines():
        m = re.match(r"^\s*0\s+3\s+\*\s+\*\s+([*1])\s+.*?/sbin/reboot\b", line)
        if m:
            return ("ежедневно в 03:00" if m.group(1) == "*"
                    else "по понедельникам в 03:00")
    return "не настроено"


