def _trafficguard_preflight() -> str | None:
    """Проверяет условия, при которых установщик TrafficGuard аварийно
    останавливается сам. Возвращает текст проблемы или None."""
    # Установщик (check_firewall_safety) делает exit 1, если ufw присутствует,
    # выключен И среди правил нет ничего про SSH. Ловим это заранее, чтобы
    # выдать понятную причину вместо «команда завершилась с кодом 1».
    if shutil.which("ufw"):
        status = probe(["ufw", "status"])
        if status.returncode == 0 and "Status: active" not in status.stdout:
            rules = probe(["ufw", "show", "added"]).stdout
            if not any(tok in rules for tok in ("22", "SSH", "OpenSSH")):
                return ("UFW выключен и не содержит правил для SSH — установщик "
                        "TrafficGuard откажется работать. Выполните `ufw allow ssh` "
                        "или включите блок «Настройка UFW».")
    return None


def block_trafficguard() -> None:
    step("TrafficGuard-auto: защита от сканеров и ботов")
    # curl нужен для загрузки установщика (пакеты установщик доставит сам)
    if shutil.which("curl") is None:
        run(["apt-get", "install", "-y", "curl"])

    problem = _trafficguard_preflight()
    if problem:
        console.print(f"[yellow]Пропускаю TrafficGuard: {problem}[/yellow]")
        return

    # Установщик ставит пакеты через apt — дождёмся блокировки dpkg
    wait_for_apt_lock()

    # ВАЖНО: оригинальный установщик в самом конце запускает ИНТЕРАКТИВНОЕ меню
    # (`/opt/trafficguard-manager.sh monitor`, оно же `rknpidor`) и читает ввод
    # из /dev/tty — это намертво заблокировало бы наш скрипт. Вырезаем ровно эту
    # строку. Раньше это делалось конвейером `curl | sed | bash`: если апстрим
    # переименует строку, sed молча ничего не удалит и мы зависнем на меню.
    # Поэтому берём проверенную копию, патчим и ПРОВЕРЯЕМ, что патч применён.
    with tempfile.TemporaryDirectory(prefix="trafficguard-") as tmpdir:
        raw = fetch_vendored("trafficguard", tmpdir)

        with open(raw, encoding="utf-8", errors="replace") as f:
            original = f.read()

        launch_re = re.compile(r"(?m)^.*trafficguard-manager\.sh\s+monitor.*$\n?")
        # В теле установщика есть heredoc с меню, где строка `monitor) show_menu`
        # не совпадает с шаблоном, — вырезаем только реальные вызовы менеджера.
        patched, removed = launch_re.subn("", original)
        if removed == 0:
            console.print(
                "[yellow]Пропускаю TrafficGuard: в установщике не найден запуск "
                "интерактивного меню, который нужно вырезать. Похоже, апстрим "
                "изменился — обновите скрипт, прежде чем ставить автоматически.[/yellow]")
            return

        patch_path = os.path.join(tmpdir, "install-patched.sh")
        with open(patch_path, "w", encoding="utf-8") as f:
            f.write(patched)

        console.print(f"[dim]Установщик пропатчен (удалено строк с меню: {removed})[/dim]")
        # stdin из /dev/null: любой невырезанный `read` завершится сразу,
        # а не подвесит установку в ожидании ввода.
        with open(os.devnull) as devnull:
            proc = subprocess.run(["bash", patch_path], env=ENV, text=True,
                                  stdin=devnull)

    # Установщик возвращает ненулевой код и при безобидных мелочах (например,
    # `systemctl restart antiscan-aggregate.timer` на ещё не созданном юните),
    # поэтому решаем по факту: появился ли бинарник traffic-guard.
    installed = os.path.exists("/usr/local/bin/traffic-guard")
    if not installed:
        raise RuntimeError(
            f"установщик TrafficGuard завершился с кодом {proc.returncode}, "
            "бинарник /usr/local/bin/traffic-guard не появился")
    if proc.returncode != 0:
        console.print(f"[yellow]Установщик вернул код {proc.returncode}, но "
                      "traffic-guard установлен — проверьте вывод выше.[/yellow]")

    console.print("[green]✓ TrafficGuard-auto установлен. "
                  "Меню мониторинга: [bold]rknpidor[/bold][/green]")


