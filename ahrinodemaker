def _apt_quiet(args: list[str]) -> subprocess.CompletedProcess:
    """apt без простыни Get:/Hit: на экране — вывод забираем в буфер."""
    env = {**os.environ, "DEBIAN_FRONTEND": "noninteractive"}
    return subprocess.run(["apt-get", "-qq", "-o", "DPkg::Lock::Timeout=300", *args],
                          env=env, text=True, capture_output=True)


def _ensure_pip() -> None:
    try:
        import pip  # noqa: F401
    except ImportError:
        # apt-get update стоит десятки секунд и заливает экран, поэтому сначала
        # пробуем поставить с текущими индексами и обновляем их только если
        # пакет не нашёлся (свежая ВМ с пустым кэшем).
        if _apt_quiet(["install", "-y", "python3-pip"]).returncode != 0:
            _apt_quiet(["update"])
            _apt_quiet(["install", "-y", "python3-pip"])


# Имя pip-пакета → имя системного пакета Debian/Ubuntu. Механическое
# преобразование ("python3-" + первый сегмент модуля) даёт неверный результат
# для точечных имён вроде ruamel.yaml, поэтому исключения задаём явно.
APT_PKG_OVERRIDES = {
    "ruamel.yaml": "python3-ruamel.yaml",
}


def ensure(pkg: str, module: str | None = None, *, purpose: str = ""):
    module = module or pkg
    try:
        return importlib.import_module(module)
    except ImportError:
        pass

    # Сообщаем, ЧТО именно ставится: иначе установка выглядит как «скрипт начал
    # ставить пакеты под ноду, ничего не спросив».
    print(f"→ Ставлю Python-модуль «{pkg}»{purpose}…", file=sys.stderr)
    _ensure_pip()
    env = {**os.environ, "DEBIAN_FRONTEND": "noninteractive",
           "PIP_ROOT_USER_ACTION": "ignore"}

    # На Debian 12+/Ubuntu 24+ системный Python «externally managed» (PEP 668),
    # поэтому ставим сразу с --break-system-packages. Вторая попытка — для
    # старых систем, где такого флага ещё нет. capture_output гасит шумный
    # вывод pip; текст ошибки покажем только если установка реально упала.
    attempts = [
        [sys.executable, "-m", "pip", "install", "-q", "--break-system-packages", pkg],
        [sys.executable, "-m", "pip", "install", "-q", pkg],
    ]
    last = None
    for cmd in attempts:
        last = subprocess.run(cmd, env=env, text=True, capture_output=True)
        if last.returncode == 0:
            break
    else:
        # Запасной путь — системный пакет через apt (python3-rich и т.п.)
        apt_pkg = APT_PKG_OVERRIDES.get(
            pkg, "python3-" + module.split(".")[0].replace("_", "-"))
        _apt_quiet(["install", "-y", apt_pkg])

    try:
        return importlib.import_module(module)
    except ImportError:
        # pip мог отработать с кодом 0 (пакет «уже установлен»), а импорт всё
        # равно не удаться — тогда stderr пуст и полезен именно stdout.
        detail = ""
        if last is not None:
            detail = (last.stderr or "").strip() or (last.stdout or "").strip()
        print(f"Не удалось установить модуль «{pkg}»:\n{detail or 'неизвестная ошибка'}",
              file=sys.stderr)
        sys.exit(1)


