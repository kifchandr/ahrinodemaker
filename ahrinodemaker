def _sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _download(url: str, dest: str, *, timeout: int = 60) -> None:
    """Скачивает файл через curl (он уже есть в системе и умеет в прокси)."""
    r = subprocess.run(["curl", "-fsSL", "--max-time", str(timeout), "-o", dest, url],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"не удалось скачать {url}: "
                           f"{(r.stderr or '').strip() or f'код {r.returncode}'}")


def fetch_vendored(key: str, dest_dir: str) -> str:
    """Кладёт зафиксированную копию стороннего скрипта в dest_dir и проверяет
    её sha256. Несовпадение — отказ: лучше не запустить ничего, чем запустить
    от root файл, который мы не опознали."""
    spec = VENDOR[key]
    dest = os.path.join(dest_dir, spec["file"])
    _download(f"{REPO_RAW_BASE}/vendor/{spec['file']}", dest)

    with open(dest, "rb") as f:
        actual = _sha256_bytes(f.read())
    if actual != spec["sha256"]:
        raise RuntimeError(
            f"контрольная сумма {spec['file']} не совпала.\n"
            f"  ожидалось: {spec['sha256']}\n"
            f"  получено:  {actual}\n"
            "Файл в vendor/ изменён без обновления sha256 в скрипте — "
            "установка прервана.")
    console.print(f"[dim]✓ {spec['file']}: sha256 совпал[/dim]")
    return dest


def vendor_upstream_state(key: str) -> tuple[str, str | None]:
    """Сравнивает нашу копию с текущим содержимым у автора.

    Возвращает ('same' | 'outdated' | 'unknown', sha256 апстрима).
    GitHub API через прокси недоступен, поэтому сверяем не коммиты, а sha256
    самого файла — это точнее: важно, изменился ли исполняемый код."""
    spec = VENDOR[key]
    with tempfile.TemporaryDirectory(prefix="vendor-check-") as tmp:
        dest = os.path.join(tmp, "upstream")
        try:
            _download(spec["upstream"], dest, timeout=30)
        except RuntimeError:
            return ("unknown", None)
        with open(dest, "rb") as f:
            up = _sha256_bytes(f.read())
    return ("same" if up == spec["sha256"] else "outdated", up)


# ================================================================== #
# БЛОКИ
# ================================================================== #
# None — «ни разу не обновляли». Ноль тут не годится: на свежезагруженном
# сервере time.monotonic() сам по себе меньше max_age, и первое же обновление
# было бы принято за недавнее и пропущено.
_apt_updated_at: float | None = None


def apt_update(*, force: bool = False, max_age: int = 600) -> None:
    """apt-get update с защитой от повторов.

    За один прогон индексы обновляли до трёх раз подряд: обновление системы,
    затем блок пакетов, затем доустановка зависимостей. Каждый вызов — это
    десятки секунд на ровном месте, а свежесть индексов за пару минут не
    меняется."""
    global _apt_updated_at
    if (not force and _apt_updated_at is not None
            and (time.monotonic() - _apt_updated_at) < max_age):
        console.print("[dim]Индексы apt уже обновлены — пропускаю update[/dim]")
        return
    run(["apt-get", "update"])
    _apt_updated_at = time.monotonic()


def ensure_packages(*pkgs: str) -> None:
    """Доустанавливает недостающие пакеты.

    Блоки не должны полагаться на то, что пользователь отметил «Установку
    пакетов»: любой блок можно выбрать отдельно, и тогда его зависимости
    отсутствуют. Раньше это давало «systemctl enable --now fail2ban returned
    non-zero exit status 1» — юнита просто не существовало."""
    missing = [p for p in pkgs if not _pkg_installed(p)]
    if not missing:
        return
    console.print(f"[dim]Доустанавливаю недостающие пакеты: "
                  f"{', '.join(missing)}[/dim]")
    try:
        run(["apt-get", "install", "-y", *missing])
    except subprocess.CalledProcessError:
        # Обычно причина — устаревшие индексы apt на свежей ВМ. Здесь force:
        # раз установка уже не прошла, кеш свежести доверия не заслуживает.
        apt_update(force=True)
        run(["apt-get", "install", "-y", *missing])


def block_packages() -> None:
    step("Установка пакетов")
    apt_update()
    # psmisc даёт fuser — без него wait_for_apt_lock() не умеет ждать dpkg
    run(["apt-get", "install", "-y", "fail2ban", "ufw", "unattended-upgrades",
         "cron", "psmisc"])
    run(["dpkg-reconfigure", "-f", "noninteractive", "unattended-upgrades"])
    run(["systemctl", "enable", "--now", "cron"], check=False)
    console.print("[green]✓ Пакеты установлены[/green]")


def service_diagnostics(unit: str, lines: int = 25) -> str:
    """Причина отказа службы из журнала. Голый «returned non-zero exit status 1»
    ничего не говорит, а разбираться приходится уже вручную по ssh."""
    out: list[str] = []
    status = probe(["systemctl", "status", unit, "--no-pager", "-l", "-n", "0"])
    if status.stdout.strip():
        out.append(status.stdout.strip())
    jrnl = probe(["journalctl", "-u", unit, "-n", str(lines), "--no-pager"])
    if jrnl.returncode == 0 and jrnl.stdout.strip():
        out.append(jrnl.stdout.strip())
    return "\n".join(out).strip()


def _fail2ban_jail(backend: str) -> str:
    return f"""[DEFAULT]
backend = {backend}

[sshd]
enabled = true
port = ssh
filter = sshd
maxretry = 5
findtime = 600
bantime = 12h
"""


def _fail2ban_backend() -> str:
    """На Debian 12 / Ubuntu 24 rsyslog не ставится по умолчанию и
    /var/log/auth.log отсутствует — с backend=auto jail sshd не поднимется
    («Failed to access socket path» / отсутствие лог-файла). Для таких систем
    единственный рабочий источник — журнал systemd."""
    if os.path.isfile("/var/log/auth.log") or os.path.isfile("/var/log/secure"):
        return "auto"
    return "systemd"


def _fail2ban_try(backend: str) -> tuple[bool, str]:
    """Пишет конфиг с указанным backend, проверяет его и пробует запустить.
    Возвращает (успех, текст проблемы)."""
    if shutil.which("fail2ban-client") is None:
        return False, ("пакет fail2ban не установлен и не смог установиться — "
                       "проверьте `apt-get install fail2ban` вручную")

    write_file("/etc/fail2ban/jail.local", _fail2ban_jail(backend))

    # fail2ban-client -t разбирает конфиг, не трогая службу: ошибку фильтра или
    # недоступный backend видно до попытки запуска.
    test = probe(["fail2ban-client", "-t"])
    if test.returncode != 0:
        return False, (test.stderr or test.stdout or "").strip()

    enable = probe(["systemctl", "enable", "--now", "fail2ban"])
    restart = probe(["systemctl", "restart", "fail2ban"])
    if enable.returncode == 0 and restart.returncode == 0:
        return True, ""
    reason = (enable.stderr or restart.stderr or "").strip()
    return False, (service_diagnostics("fail2ban") or reason)


def block_fail2ban() -> None:
    step("Настройка Fail2Ban")
    ensure_packages("fail2ban")
    backend = _fail2ban_backend()
    console.print(f"[dim]backend для jail sshd: {backend}[/dim]")

    # Для backend=systemd fail2ban читает журнал через python3-systemd. Пакет
    # идёт лишь в Recommends, и при установке с --no-install-recommends (или на
    # урезанном образе) служба падает при старте с ImportError.
    if backend == "systemd" and not _pkg_installed("python3-systemd"):
        console.print("[dim]Доустанавливаю python3-systemd (нужен для "
                      "backend=systemd)…[/dim]")
        run(["apt-get", "install", "-y", "python3-systemd"], check=False)

    ok, problem = _fail2ban_try(backend)

    # Запасной путь: если systemd-backend всё же не поднялся, пробуем добыть
    # /var/log/auth.log через rsyslog и переключиться на auto. Обратный порядок
    # тоже возможен — auto не работает без файла журнала.
    if not ok and backend == "systemd":
        console.print(f"[yellow]backend=systemd не заработал:[/yellow]\n{problem}")
        console.print("[cyan]Пробую через rsyslog и backend=auto…[/cyan]")
        run(["apt-get", "install", "-y", "rsyslog"], check=False)
        run(["systemctl", "enable", "--now", "rsyslog"], check=False)
        time.sleep(2)   # rsyslog должен успеть создать /var/log/auth.log
        ok, problem = _fail2ban_try("auto")
    elif not ok and backend == "auto":
        console.print(f"[yellow]backend=auto не заработал:[/yellow]\n{problem}")
        console.print("[cyan]Пробую backend=systemd…[/cyan]")
        if not _pkg_installed("python3-systemd"):
            run(["apt-get", "install", "-y", "python3-systemd"], check=False)
        ok, problem = _fail2ban_try("systemd")

    if not ok:
        raise RuntimeError("не удалось запустить fail2ban.\n" + problem)

    # Служба может стартовать и тут же упасть из-за неверного фильтра —
    # проверяем, что jail действительно поднялся, а не просто «команда прошла».
    #
    # Юнит fail2ban — Type=simple, поэтому `systemctl restart` возвращает
    # управление до того, как демон создаст /var/run/fail2ban/fail2ban.sock.
    # Сразу после restart клиент отвечает «Failed to access socket path… Is
    # fail2ban running?», хотя служба в порядке, — ждём готовности сокета.
    for attempt in range(15):
        if probe(["fail2ban-client", "ping"]).returncode == 0:
            jail = probe(["fail2ban-client", "status", "sshd"])
            if jail.returncode == 0:
                console.print("[green]✓ Fail2Ban настроен, jail sshd активен[/green]")
                return
            console.print("[yellow]Fail2Ban работает, но jail sshd не найден:"
                          f"[/yellow]\n{(jail.stderr or jail.stdout or '').strip()}")
            return
        # Если служба уже упала, ждать готовности сокета бессмысленно
        if attempt >= 2 and probe(["systemctl", "is-active", "--quiet",
                                   "fail2ban"]).returncode != 0:
            break
        time.sleep(1)

    console.print("[yellow]Fail2Ban не отвечает после запуска:[/yellow]\n"
                  + (service_diagnostics("fail2ban", 15) or "нет данных в журнале"))


