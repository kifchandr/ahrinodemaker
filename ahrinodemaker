def _panel_reference() -> str:
    """Справка для панели. Собирается из TORRENT_PORTS, чтобы список портов
    гарантированно совпадал с тем, что применяет egress-фильтр."""
    ports_range = f"{min(TORRENT_PORTS)}-{max(p for p in TORRENT_PORTS if p < 10000)}"
    tail = sorted(p for p in TORRENT_PORTS if p >= 10000)
    port_expr = ",".join([ports_range, *(str(p) for p in tail)])
    return json.dumps({
        "routingRulesToAdd": [
            {"type": "field", "port": port_expr,
             "ruleTag": "TORRENT_BY_PORT", "outboundTag": "BLOCK"},
            {"type": "field", "protocol": ["bittorrent"], "outboundTag": "TORRENT"},
        ],
        "nodePluginConfig": {
            "torrentBlocker": {
                "enabled": True,
                "ignoreLists": {"ip": [], "userId": []},
                "blockDuration": 86400,
                "includeRuleTags": ["TORRENT_BY_PORT"],
            },
            "egressFilter": {
                "enabled": True,
                "blockedPorts": TORRENT_PORTS,
            },
        },
    }, indent=2, ensure_ascii=False) + "\n"


def _install_repo_key(url: str, keyring: str) -> None:
    """Кладёт GPG-ключ репозитория в keyring.

    Раньше это был конвейер `curl … | gpg --dearmor -o …`, и он не различал
    причины отказа: gpg возвращает 2 и когда вход пустой (curl не скачал), и
    когда содержимое не является ключом (например, страница с ошибкой). Здесь
    шаги разделены, поэтому в сообщение попадает настоящая причина."""
    with tempfile.TemporaryDirectory(prefix="repokey-") as tmpdir:
        raw = os.path.join(tmpdir, "key")
        _download(url, raw, timeout=30)   # ошибка curl всплывёт как есть

        size = os.path.getsize(raw)
        if size == 0:
            raise RuntimeError(f"GPG-ключ по адресу {url} пустой")

        with open(raw, "rb") as f:
            head = f.read(64)

        out = os.path.join(tmpdir, "keyring.gpg")
        if head.startswith(b"-----BEGIN PGP"):
            # ASCII-armored — приводим к бинарному виду
            r = subprocess.run(["gpg", "--yes", "--dearmor", "-o", out, raw],
                               capture_output=True, text=True)
            if r.returncode != 0:
                raise RuntimeError(
                    f"gpg не смог разобрать ключ {url}: "
                    f"{(r.stderr or '').strip() or f'код {r.returncode}'}")
        else:
            # Уже бинарный keyring — проверяем, что это действительно ключ
            check = subprocess.run(["gpg", "--show-keys", raw],
                                   capture_output=True, text=True)
            if check.returncode != 0:
                preview = head.decode("utf-8", "replace").replace("\n", " ")[:80]
                raise RuntimeError(
                    f"по адресу {url} лежит не GPG-ключ ({size} байт, "
                    f"начало: «{preview}»): {(check.stderr or '').strip()}")
            shutil.copyfile(raw, out)

        os.makedirs(os.path.dirname(keyring), exist_ok=True)
        shutil.copyfile(out, keyring)
        os.chmod(keyring, 0o644)

    if not (os.path.isfile(keyring) and os.path.getsize(keyring) > 0):
        raise RuntimeError(f"keyring {keyring} не создан")
    console.print(f"[green]✓ GPG-ключ репозитория записан: {keyring}[/green]")


REPO_BASE = "https://repo.remna.dev/xray-tools"


def _repo_architectures(base_url: str, suite: str) -> list[str]:
    """Архитектуры, объявленные репозиторием в dists/<suite>/Release.

    Гадать здесь нельзя: `arch=` в источнике должен совпадать с тем, какие
    индексы репозиторий реально публикует. Repo на OpenRepo выкладывает
    binary-any/, обычные Debian-репозитории — binary-amd64/ и т.п.; при
    несовпадении apt молча не видит ни одного пакета и выдаёт лишь
    «Unable to locate package»."""
    with tempfile.TemporaryDirectory(prefix="release-") as tmpdir:
        dest = os.path.join(tmpdir, "Release")
        try:
            _download(f"{base_url}/dists/{suite}/Release", dest, timeout=30)
        except RuntimeError:
            return []
        with open(dest, encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("Architectures:"):
                    return line.split(":", 1)[1].split()
    return []


def _install_tblocker_package() -> None:
    """Подключает репозиторий remna.dev и ставит пакет tblocker."""
    ensure_packages("curl", "gnupg", "ca-certificates")
    keyring  = "/usr/share/keyrings/openrepo-xray-tools.gpg"
    listfile = "/etc/apt/sources.list.d/openrepo-xray-tools.list"

    # Ключ переустанавливаем, если его нет или он пустой: раньше сбой curl
    # приводил к нулевому keyring, после чего apt-get update падал навсегда —
    # listfile уже существовал и ветка пересоздания ключа не выполнялась.
    key_ok = os.path.isfile(keyring) and os.path.getsize(keyring) > 0
    if not key_ok:
        _install_repo_key(f"{REPO_BASE}/public.gpg", keyring)

    # Архитектуру берём из Release самого репозитория. Ни «any» вслепую, ни
    # dpkg --print-architecture вслепую не годятся: первое ломается на обычных
    # репозиториях, второе — на OpenRepo, который публикует binary-any/.
    host_arch = probe(["dpkg", "--print-architecture"]).stdout.strip() or "amd64"
    declared = _repo_architectures(REPO_BASE, "stable")
    if host_arch in declared:
        arch = host_arch
    elif "any" in declared:
        arch = "any"
    elif declared:
        arch = ",".join(a for a in declared if a != "all") or host_arch
    else:
        # Release недоступен — перечисляем оба варианта. Индекс, которого у
        # репозитория нет, apt пропустит, а не сочтёт ошибкой.
        arch = f"{host_arch},any"
    console.print(f"[dim]Архитектура репозитория: {arch}"
                  f"{' (объявлено: ' + ' '.join(declared) + ')' if declared else ''}[/dim]")

    write_file(listfile,
               f"deb [arch={arch} signed-by={keyring}] "
               f"{REPO_BASE}/ stable main\n")

    # force: только что добавили новый список источников
    apt_update(force=True)

    try:
        run(["apt-get", "install", "-y", "tblocker"])
    except subprocess.CalledProcessError:
        # «Unable to locate package» не объясняет, что пошло не так: репозиторий
        # мог не подключиться, отдать индекс другой архитектуры или другой suite.
        policy = probe(["apt-cache", "policy", "tblocker"]).stdout.strip()
        raise RuntimeError(
            "пакет tblocker не найден в репозитории.\n"
            f"  источник: {REPO_BASE}/ stable main (arch={arch})\n"
            f"  архитектуры по Release: {' '.join(declared) or 'не удалось прочитать'}\n"
            f"  apt-cache policy tblocker:\n{policy or '  (пусто)'}\n"
            "  Проверьте вручную: apt-get update 2>&1 | grep -i remna")


def _setup_egress_filter() -> None:
    """Скрипт + systemd service/timer для резервной блокировки портов через nft."""
    os.makedirs(INSTALL_DIR, exist_ok=True)
    script_path = f"{INSTALL_DIR}/apply-torrent-egress-filter.sh"
    write_file(script_path, EGRESS_SCRIPT, mode=0o755)
    write_file("/etc/systemd/system/torrent-egress-filter.service", EGRESS_SERVICE)
    write_file("/etc/systemd/system/torrent-egress-filter.timer", EGRESS_TIMER)
