# Обновление remnanode (docker compose pull + пересоздание контейнера)
# ------------------------------------------------------------------ #
_SHA_RE = re.compile(r"sha256:[0-9a-f]{64}")


def _image_from_compose_text(path: str) -> str | None:
    """Запасной разбор image: без YAML-парсера.

    Нужен, чтобы простая проверка версии ноды не тянула установку ruamel.yaml:
    раньше вход в раздел «Remnawave Node» ставил модуль ещё до того, как
    пользователь выбрал хоть один блок."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    images: list[tuple[str, str]] = []   # (имя сервиса, образ)
    service = ""
    for ln in lines:
        if re.match(r"^\s{2}\S.*:\s*$", ln) and not ln.startswith("    "):
            service = ln.strip().rstrip(":")
        m = re.match(r"^\s+image:\s*['\"]?([^'\"#\s]+)", ln)
        if m:
            images.append((service, m.group(1)))
    if not images:
        return None
    for name, image in images:
        if "remna" in name.lower():
            return image
    return images[0][1]


def _node_image_from_compose(path: str) -> str | None:
    """Достаёт имя образа сервиса ноды из docker-compose.yml."""
    try:
        # Только если модуль уже есть — ставить его ради чтения не будем.
        from ruamel.yaml import YAML
        yaml = YAML(typ="safe")
        with open(path, encoding="utf-8") as f:
            data = yaml.load(f)
    except ImportError:
        return _image_from_compose_text(path)
    except Exception:
        return None
    if not isinstance(data, dict):
        return None
    services = data.get("services") or {}
    svc = None
    if "remnanode" in services:
        svc = services["remnanode"]
    elif len(services) == 1:
        svc = next(iter(services.values()))
    else:
        for name, s in services.items():
            if "remna" in str(name).lower():
                svc = s
                break
        if svc is None and services:
            svc = next(iter(services.values()))
    if isinstance(svc, dict) and svc.get("image"):
        return str(svc["image"])
    return None


def _local_image_digests(image: str) -> set[str]:
    """sha256-дайджесты образа, имеющегося локально (пусто — образа нет)."""
    r = probe(["docker", "image", "inspect", "--format",
               "{{range .RepoDigests}}{{println .}}{{end}}{{.Id}}", image])
    return set(_SHA_RE.findall(r.stdout)) if r.returncode == 0 else set()


def _remote_image_digests(image: str) -> set[str]:
    """sha256-дайджесты образа в реестре. Пробуем buildx и manifest;
    если оба недоступны — пустое множество (проверить не удалось)."""
    env = {**os.environ, "DOCKER_CLI_EXPERIMENTAL": "enabled"}
    digests: set[str] = set()
    for cmd in (["docker", "buildx", "imagetools", "inspect", image],
                ["docker", "manifest", "inspect", image]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True,
                               env=env, timeout=25)
        except (subprocess.TimeoutExpired, OSError):
            continue
        if r.returncode == 0:
            digests |= set(_SHA_RE.findall(r.stdout))
    return digests


def node_update_status() -> tuple[str, str | None, str | None]:
    """Состояние ноды:
      'absent'  — ноды на сервере нет (пункт не показываем);
      'update'  — образ устарел или отсутствует локально (нужно обновление);
      'latest'  — установлена последняя версия (пункт скрываем);
      'unknown' — реестр недоступен, версию проверить не удалось.
    Возвращает (status, compose_path, image)."""
    try:
        candidates = find_compose_candidates()
    except Exception:
        candidates = []
    if not candidates:
        return ("absent", None, None)
    path = candidates[0]
    image = _node_image_from_compose(path)
    if not image:
        return ("absent", path, None)
    # Без docker судить об образе нельзя: раньше пустой список локальных
    # дайджестов трактовался как «нужно обновление» и предлагал бесполезный пункт.
    if shutil.which("docker") is None:
        return ("absent", path, image)
    local = _local_image_digests(image)
    if not local:
        return ("update", path, image)      # образа локально нет — точно тянем
    remote = _remote_image_digests(image)
    if not remote:
        return ("unknown", path, image)     # не смогли обратиться к реестру
    return ("latest" if (local & remote) else "update", path, image)


def block_node_update(compose_path: str | None = None) -> None:
    step("Обновление remnanode (docker compose pull + пересоздание)")
    if not compose_path:
        candidates = find_compose_candidates()
        compose_path = candidates[0] if candidates else None
    if not compose_path or not os.path.isfile(compose_path):
        console.print("[yellow]docker-compose ноды не найден — обновление пропущено.[/yellow]")
        return
    base = compose_base(compose_path)
    if base is None:
        console.print("[yellow]docker compose не найден — обновление пропущено.[/yellow]")
        return
    run(base + ["pull"])
    # Раньше здесь был `down` + `up`, что давало лишний простой ноды: compose
    # сам пересоздаёт контейнер, если образ изменился.
    # -d обязателен: без него `up` висит в foreground и блокирует скрипт
    run(base + ["up", "-d", "--remove-orphans"])
    console.print("[green]✓ remnanode обновлён и перезапущен[/green]")


# ------------------------------------------------------------------ #
# Hysteria2 (QUIC) поверх уже работающей ноды
# ------------------------------------------------------------------ #
# Hysteria2 в Remnawave требует TLS-сертификата в виде файлов, доступных
# контейнеру. Сертификаты Let's Encrypt лежат на хосте, поэтому их кладут в
# /dev/shm (tmpfs) и монтируют внутрь: файлы не попадают на диск и обновляются
# по расписанию вместе с продлением сертификата.
SHM_VOLUME = "/dev/shm:/dev/shm"
HYSTERIA_CERT = "/dev/shm/hysteria_cert.pem"
HYSTERIA_KEY = "/dev/shm/hysteria_key.pem"
HYSTERIA_PORT = "443/udp"
HYSTERIA_CRON_MARKER = "# AhriNode tool: сертификаты Hysteria2"
LETSENCRYPT_LIVE = "/etc/letsencrypt/live"


def _cert_paths(domain: str) -> tuple[str, str]:
    base = os.path.join(LETSENCRYPT_LIVE, domain)
    return os.path.join(base, "fullchain.pem"), os.path.join(base, "privkey.pem")


def _host_addresses() -> set[str]:
    """Публичные адреса этого сервера — чтобы заранее поймать неверный A-запись."""
    out = probe(["ip", "-4", "-o", "addr", "show", "scope", "global"]).stdout
    return set(re.findall(r"inet\s+(\d{1,3}(?:\.\d{1,3}){3})", out))


# Удостоверяющие центры с бесплатным ACME. Привязка к одному УЦ — лишний риск:
# у любого бывают перебои, лимиты и собственные ограничения по доменным зонам.
#
# eab (External Account Binding) — предварительная регистрация в УЦ: kid и
# hmac-ключ берутся в личном кабинете. Без них ZeroSSL и Google по ACME не
# выдают. email обязателен там, где УЦ не принимает анонимную регистрацию.
ACME_PROVIDERS = {
    "letsencrypt": {
        "title": "Let's Encrypt — по умолчанию",
        "server": None,          # адрес по умолчанию в самом certbot
        "eab": False, "email_required": False,
    },
    "buypass": {
        "title": "Buypass Go SSL — норвежский УЦ, без регистрации",
        "server": "https://api.buypass.com/acme/directory",
        "eab": False, "email_required": True,
    },
    "zerossl": {
        "title": "ZeroSSL — нужны EAB-ключи из личного кабинета",
        "server": "https://acme.zerossl.com/v2/DV90",
        "eab": True, "email_required": True,
    },
    "google": {
        "title": "Google Trust Services — нужны EAB-ключи",
        "server": "https://dv.acme-v02.api.pki.goog/directory",
        "eab": True, "email_required": True,
    },
}


def ask_acme_provider() -> dict | None:
    """Спрашивает УЦ и его реквизиты до начала выпуска."""
    choice = questionary.select(
        "Каким удостоверяющим центром выпустить сертификат?",
        choices=[questionary.Choice(spec["title"], value=key)
                 for key, spec in ACME_PROVIDERS.items()],
        style=CUSTOM_STYLE).ask()
    if choice is None:
        return None

    spec = ACME_PROVIDERS[choice]
    acme = {"provider": choice, "server": spec["server"],
            "email": "", "eab_kid": "", "eab_key": ""}

    prompt = ("E-mail для уведомлений об истечении"
              + (":" if spec["email_required"] else " (Enter — без него):"))
    email = questionary.text(prompt, default="", style=CUSTOM_STYLE).ask()
    if email is None:
        return None
    acme["email"] = email.strip()
    if spec["email_required"] and not acme["email"]:
        console.print(f"[red]{spec['title']} требует e-mail.[/red]")
        return None

    if spec["eab"]:
        kid = questionary.text("EAB Key ID (kid):", default="",
                               style=CUSTOM_STYLE).ask()
        key = questionary.text("EAB HMAC Key:", default="",
                               style=CUSTOM_STYLE).ask()
        if not kid or not key or not kid.strip() or not key.strip():
            console.print("[red]Без EAB-ключей этот УЦ сертификат не выдаст.[/red]")
            return None
        acme["eab_kid"] = kid.strip()
        acme["eab_key"] = key.strip()

    return acme


def issue_certificate(domain: str, acme: dict | None = None) -> None:
    """Выпускает сертификат через certbot в режиме standalone.

    standalone поднимает временный веб-сервер на 80 порту: у ноды его никто не
    занимает (Xray слушает 443), а webroot требовал бы уже работающего
    веб-сервера. Проверка домена — HTTP-01, поэтому A-запись должна указывать
    на этот сервер."""
    acme = acme or {"provider": "letsencrypt", "server": None,
                    "email": "", "eab_kid": "", "eab_key": ""}
    title = ACME_PROVIDERS.get(acme["provider"], {}).get("title", acme["provider"])
    step(f"Выпуск сертификата для {domain} ({title})")
    ensure_packages("certbot")

    # Предупреждаем до обращения к Let's Encrypt: у них жёсткие лимиты на
    # неудачные попытки (5 в час на домен), и упереться в них легко.
    resolved = probe(["getent", "ahostsv4", domain]).stdout
    resolved_ips = set(re.findall(r"^(\d{1,3}(?:\.\d{1,3}){3})", resolved, re.M))
    local_ips = _host_addresses()
    if resolved_ips and local_ips and not (resolved_ips & local_ips):
        console.print(
            f"[yellow]Внимание: {domain} указывает на "
            f"{', '.join(sorted(resolved_ips))}, а адреса этого сервера — "
            f"{', '.join(sorted(local_ips))}. Проверка Let's Encrypt, скорее "
            "всего, не пройдёт.[/yellow]")
    elif not resolved_ips:
        console.print(f"[yellow]Внимание: {domain} не резолвится — проверьте "
                      "A-запись.[/yellow]")

    # Порт 80 нужен для проверки HTTP-01
    if shutil.which("ufw") and "Status: active" in probe(["ufw", "status"]).stdout:
        run(["ufw", "allow", "80/tcp"], check=False)

    cmd = ["certbot", "certonly", "--standalone", "--non-interactive",
           "--agree-tos", "--http-01-port", "80", "-d", domain]
    if acme.get("server"):
        cmd += ["--server", acme["server"]]
    if acme.get("email"):
        cmd += ["--email", acme["email"]]
    else:
        cmd += ["--register-unsafely-without-email"]
    if acme.get("eab_kid"):
        cmd += ["--eab-kid", acme["eab_kid"], "--eab-hmac-key", acme["eab_key"]]

    try:
        run(cmd)
    except subprocess.CalledProcessError as exc:
        # Частая причина — отказ конкретного УЦ (лимиты, доменная зона,
        # недоступность). Подсказываем, что выход есть.
        raise RuntimeError(
            f"{title} не выдал сертификат (код {exc.returncode}).\n"
            "  Подробности — в /var/log/letsencrypt/letsencrypt.log.\n"
            "  Если дело в самом УЦ, запустите блок заново и выберите другой: "
            + ", ".join(s["title"].split(" —")[0]
                        for k, s in ACME_PROVIDERS.items()
                        if k != acme["provider"]))

    cert, key = _cert_paths(domain)
    if not (os.path.isfile(cert) and os.path.isfile(key)):
        raise RuntimeError(f"certbot отработал, но {cert} не появился")
    console.print(f"[green]✓ Сертификат выпущен: {cert}[/green]")
    console.print("[dim]Продление берёт на себя таймер certbot; наш cron "
                  "ежедневно копирует свежие файлы в /dev/shm.[/dim]")


def letsencrypt_domains() -> list[str]:
    """Домены, для которых есть полный комплект файлов сертификата."""
    try:
        entries = sorted(os.listdir(LETSENCRYPT_LIVE))
    except OSError:
        return []
    found = []
    for name in entries:
        base = os.path.join(LETSENCRYPT_LIVE, name)
        if (os.path.isdir(base)
                and os.path.isfile(os.path.join(base, "fullchain.pem"))
                and os.path.isfile(os.path.join(base, "privkey.pem"))):
            found.append(name)
    return found


def _sync_hysteria_certs(domain: str) -> bool:
    """Копирует сертификаты в /dev/shm. True — файлы изменились."""
    src_cert = os.path.join(LETSENCRYPT_LIVE, domain, "fullchain.pem")
    src_key = os.path.join(LETSENCRYPT_LIVE, domain, "privkey.pem")

    def same(a: str, b: str) -> bool:
        try:
            with open(a, "rb") as f1, open(b, "rb") as f2:
                return f1.read() == f2.read()
        except OSError:
            return False

    if same(src_cert, HYSTERIA_CERT) and same(src_key, HYSTERIA_KEY):
        console.print("[green]✓ Сертификаты в /dev/shm актуальны[/green]")
        return False

    shutil.copyfile(src_cert, HYSTERIA_CERT)
    shutil.copyfile(src_key, HYSTERIA_KEY)
    # 644: файлы читает процесс внутри контейнера. /dev/shm — tmpfs в памяти,
    # на диск приватный ключ при этом не попадает.
    os.chmod(HYSTERIA_CERT, 0o644)
    os.chmod(HYSTERIA_KEY, 0o644)
    console.print("[green]✓ Сертификаты скопированы в /dev/shm[/green]")
    return True


def _hysteria_cron(domain: str) -> None:
    """Сертификаты живут в tmpfs: после перезагрузки /dev/shm пуст, а после
    продления Let's Encrypt копии устаревают. Обе ситуации закрывает cron."""
    src_cert = os.path.join(LETSENCRYPT_LIVE, domain, "fullchain.pem")
    src_key = os.path.join(LETSENCRYPT_LIVE, domain, "privkey.pem")
    copy = (f"cp {src_cert} {HYSTERIA_CERT} && cp {src_key} {HYSTERIA_KEY} "
            f"&& chmod 644 {HYSTERIA_CERT} {HYSTERIA_KEY}")
    lines = [
        # sleep 15 — дать докеру подняться после старта системы
        f"@reboot {copy} && sleep 15 && docker restart remnanode",
        f"0 4 * * * {copy} && docker restart remnanode",
    ]
    _crontab_replace_block(HYSTERIA_CRON_MARKER, lines)
    console.print("[green]✓ Обновление сертификатов добавлено в cron "
                  "(при загрузке и ежедневно в 04:00)[/green]")


HYSTERIA_INBOUND_TAG = "HYSTERIA2"


def hysteria_inbound_reference(domain: str, port: int = 443) -> str:
    """Готовый inbound для вставки в конфиг ноды через панель.

    Схема сверена с исходниками Xray-core: протокол называется «hysteria»,
    settings.version обязан быть 2 (иначе ядро откажет с «version != 2»),
    пользователи описываются полем auth. clients — синоним users; пустой
    список заполняет панель."""
    return json.dumps({
        "tag": HYSTERIA_INBOUND_TAG,
        "port": port,
        "listen": "0.0.0.0",
        "protocol": "hysteria",
        "settings": {
            "version": 2,
            "clients": [],
        },
        # sniffing нужен, даже если конвертеры его опускают: правило
        # BLOCK_BITTORRENT срабатывает по protocol=bittorrent, а определить
        # протокол без sniffing нельзя. Заодно без него в access.log не попадают
        # домены — и tblocker не увидит торрент-трафик этого inbound'а.
        "sniffing": {
            "enabled": True,
            "destOverride": ["http", "tls", "quic"],
        },
        "streamSettings": {
            "network": "hysteria",
            "security": "tls",
            # congestion принимает reno | bbr | brutal | force-brutal
            # (infra/conf/transport_internet.go). bbr — разумный выбор для QUIC.
            "finalmask": {
                "quicParams": {
                    "debug": False,
                    "congestion": "bbr",
                },
            },
            "tlsSettings": {
                "alpn": ["h3"],
                "certificates": [
                    {
                        "certificateFile": HYSTERIA_CERT,
                        "keyFile": HYSTERIA_KEY,
                    }
                ],
            },
            "hysteriaSettings": {
                "version": 2,
            },
        },
    }, indent=2, ensure_ascii=False) + "\n"


def block_hysteria(params: tuple[str, dict | None] | None = None) -> None:
    step("Hysteria2 (QUIC): сертификаты, порт 443/udp, автообновление")
    domain, acme = params if params else (None, None)

    # 1. Нода должна существовать и работать: настраивать транспорт не для чего
    if shutil.which("docker") is None:
        raise RuntimeError("Docker не установлен — сначала установите ноду")
    state = probe(["docker", "inspect", "-f", "{{.State.Status}}", "remnanode"])
    if state.returncode != 0:
        raise RuntimeError("контейнер remnanode не найден — сначала установите ноду")
    if state.stdout.strip() != "running":
        raise RuntimeError(f"контейнер remnanode не запущен "
                           f"(статус: {state.stdout.strip() or 'неизвестно'})")

    # 2. Сертификаты. Если их нет — выпускаем сами, домен спрошен заранее
    domains = letsencrypt_domains()
    if domain and domain not in domains:
        issue_certificate(domain, acme)
        domains = letsencrypt_domains()
    if not domains:
        raise RuntimeError(
            f"в {LETSENCRYPT_LIVE} нет сертификатов Let's Encrypt и домен для "
            "выпуска не задан.\n"
            "  Hysteria2 требует TLS-сертификат домена: либо укажите домен, "
            "чтобы скрипт выпустил сертификат сам, либо выпустите его заранее "
            "(это делает и reverse-proxy, если нода ставится через него).")
    if domain not in domains:
        domain = domains[0]
    console.print(f"[bold]Домен:[/bold] {domain}")

    # 3. /dev/shm внутрь контейнера — иначе он не увидит сертификаты
    compose_path = None
    candidates = find_compose_candidates()
    if candidates:
        compose_path = candidates[0]
    mounts = probe(["docker", "inspect", "-f", "{{json .Mounts}}", "remnanode"]).stdout
    shm_mounted = "/dev/shm" in mounts
    compose_changed = False
    if not shm_mounted:
        if not compose_path:
            raise RuntimeError(
                "/dev/shm не примонтирован в контейнер, а docker-compose ноды "
                "не найден — добавьте в него вручную: - /dev/shm:/dev/shm")
        result = patch_compose_volume(compose_path, SHM_VOLUME)
        if result == "added":
            console.print(f"[green]✓ /dev/shm добавлен в {compose_path}[/green]")
            compose_changed = True
        elif result != "exists":
            raise RuntimeError(f"не удалось добавить /dev/shm в {compose_path}: "
                               f"{result}")
    else:
        console.print("[green]✓ /dev/shm уже примонтирован в контейнер[/green]")

    # 4. Порт QUIC
    if shutil.which("ufw") and probe(["ufw", "status"]).stdout.count("Status: active"):
        run(["ufw", "allow", HYSTERIA_PORT], check=False)
        console.print(f"[green]✓ Открыт порт {HYSTERIA_PORT}[/green]")
    else:
        console.print(f"[yellow]UFW неактивен — откройте {HYSTERIA_PORT} "
                      "самостоятельно.[/yellow]")

    # 5. Сертификаты в tmpfs + расписание обновления
    certs_changed = _sync_hysteria_certs(domain)
    _hysteria_cron(domain)

    # 6. Перезапуск нужен, только если что-то поменялось
    if compose_changed:
        recreate_node(compose_path)
    elif certs_changed:
        console.print("[cyan]Перезапускаю контейнер (сертификаты обновлены)…[/cyan]")
        run(["docker", "restart", "remnanode"], check=False)
    else:
        console.print("[green]✓ Перезапуск не требуется[/green]")

    # 7. Готовый inbound для вставки в конфиг ноды через панель
    ref_path = f"{INSTALL_DIR}/panel-hysteria-inbound.json"
    write_file(ref_path, hysteria_inbound_reference(domain))
    console.print(f"[green]✓ Заготовка inbound: {ref_path}[/green]")

    console.print(
        "[bold yellow]Важно:[/bold yellow] серверная часть готова, но сам "
        "inbound Hysteria2 включается в панели Remnawave: добавьте содержимое "
        f"{ref_path} в массив inbounds конфига ноды, впишите тег "
        f"«{HYSTERIA_INBOUND_TAG}» в правило маршрутизации на ваш outbound, "
        "создайте Host и внесите inbound в Squad.")


# Последняя метка обязана начинаться с буквы: это отсекает IP-адреса, но
# пропускает punycode-домены верхнего уровня вроде xn--p1ai (.рф).
DOMAIN_RE = re.compile(
    r"^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+"
    r"[a-z][a-z0-9-]{0,61}[a-z0-9]$",
    re.IGNORECASE)


def normalize_domain(raw: str) -> str | None:
    """Приводит ввод к виду, понятному certbot, или возвращает None.

    Кириллические домены переводятся в punycode: пользователь пишет «мой.рф»,
    а Let's Encrypt и Xray работают с xn--… ."""
    domain = raw.strip().lower().rstrip(".")
    if not domain:
        return None
    try:
        domain = domain.encode("idna").decode("ascii")
    except (UnicodeError, ValueError):
        return None
    return domain if DOMAIN_RE.match(domain) else None


def ask_hysteria_params() -> tuple[str, dict | None] | None:
    """Домен и, если сертификат надо выпускать, удостоверяющий центр.
    Всё спрашивается заранее, чтобы выполнение шло без вопросов."""
    domains = letsencrypt_domains()

    if not domains:
        console.print(f"[dim]В {LETSENCRYPT_LIVE} сертификатов нет — "
                      "могу выпустить через certbot.[/dim]")
        raw = questionary.text(
            "Домен для Hysteria2 (A-запись должна указывать на этот сервер).\n"
            "  Enter — пропустить, тогда блок Hysteria2 будет пропущен.\n"
            "  Домен:",
            default="", style=CUSTOM_STYLE).ask()
        if not raw:
            return None
        domain = normalize_domain(raw)
        if domain is None:
            console.print(f"[red]«{raw.strip()}» не похож на доменное имя.[/red]")
            return None
        acme = ask_acme_provider()
        return None if acme is None else (domain, acme)

    choices = [*domains, "Выпустить сертификат для другого домена"]
    if len(domains) == 1:
        choices = [f"{domains[0]}   [сертификат уже есть]",
                   "Выпустить сертификат для другого домена"]
    choice = questionary.select(
        "Домен, чьим сертификатом будет пользоваться Hysteria2:",
        choices=choices, style=CUSTOM_STYLE).ask()
    if choice is None:
        return None
    if choice.startswith("Выпустить"):
        raw = questionary.text("Новый домен:", default="", style=CUSTOM_STYLE).ask()
        if not raw:
            return None
        domain = normalize_domain(raw)
        if domain is None:
            console.print(f"[red]«{raw.strip()}» не похож на доменное имя.[/red]")
            return None
        acme = ask_acme_provider()
        return None if acme is None else (domain, acme)
    # Сертификат уже есть — выпускать ничего не нужно
    return (choice.split()[0], None)


# ------------------------------------------------------------------ #
# WARP: чистый egress для сервисов, режущих IP дата-центров
# ------------------------------------------------------------------ #
# Нейросети, Spotify и часть стримингов блокируют адреса хостингов. WARP даёт
# ноде второй выход в интернет через Cloudflare, и в панели можно направить
# туда только нужные домены — остальной трафик продолжает идти напрямую.
#
# Взят вариант с отдельным контейнером, отдающим SOCKS5 на localhost, а не
# wireguard-outbound внутри Xray: тот требует вычислять поле reserved из
# client_id аккаунта WARP, и при неверном значении хэндшейк молча висит.
# Контейнер держит туннель сам и переживает перезапуск ноды.
WARP_DIR = "/opt/warp"
WARP_SOCKS_PORT = 40000
WARP_CONTAINER = "warp"

def warp_compose(license_key: str = "") -> str:
    """docker-compose для контейнера WARP.

    Бесплатный WARP отдаёт сильно разделяемые адреса, которые Google и OpenAI
    регулярно помечают как подозрительные. Ключ WARP+ подставляется в
    WARP_LICENSE_KEY и заметно улучшает положение."""
    env = ["      - WARP_SLEEP=2"]
    if license_key:
        env.append(f"      - WARP_LICENSE_KEY={license_key}")
    return f"""services:
  warp:
    image: caomingjun/warp
    container_name: {WARP_CONTAINER}
    restart: always
    ports:
      - "127.0.0.1:{WARP_SOCKS_PORT}:1080"
    environment:
{chr(10).join(env)}
    cap_add:
      - NET_ADMIN
    sysctls:
      - net.ipv4.conf.all.src_valid_mark=1
    volumes:
      - ./data:/var/lib/cloudflare-warp
"""

# Домены, которые имеет смысл выпускать через WARP. Список — отправная точка,
# править его удобнее в панели: он попадает в справку, а не в код ноды.
#
# ВАЖНО про Google: мало направить в WARP только gemini.google.com. Страница
# тянет авторизацию и API с соседних доменов, и если они пойдут напрямую, Google
# увидит в одной сессии два разных адреса — узел и WARP — и покажет
# «Мы зарегистрировали подозрительный трафик». Поэтому вся сессионная обвязка
# Google идёт тем же маршрутом, что и сам Gemini.
WARP_DOMAINS = [
    # OpenAI / ChatGPT
    "geosite:openai",
    "domain:chatgpt.com",
    "domain:oaistatic.com",
    "domain:oaiusercontent.com",
    # Google AI + сессионные домены: порознь их пускать нельзя
    "domain:gemini.google.com",
    "domain:aistudio.google.com",
    "domain:notebooklm.google.com",
    "domain:generativelanguage.googleapis.com",
    # accounts.google.com обязателен для консистентности сессии, но учтите:
    # через WARP пойдут ВСЕ входы в Google, включая YouTube и почту.
    "domain:accounts.google.com",
    "domain:apis.google.com",
    "domain:clients6.google.com",
    "domain:googleusercontent.com",
    # gstatic.com сюда намеренно НЕ входит: это бескуковый CDN статики, к
    # опознанию сессии он отношения не имеет, зато используется ютубом и
    # остальными сервисами Google — маршрут через WARP только добавил бы им
    # задержку.
    # Прочие нейросети
    "domain:claude.ai",
    "domain:anthropic.com",
    "domain:perplexity.ai",
    # Стриминги, режущие адреса хостингов
    "domain:spotify.com",
    "domain:scdn.co",
]


def _warp_socks_address() -> str:
    """Адрес SOCKS-прокси с точки зрения контейнера ноды.

    При network_mode: host контейнер видит localhost хоста напрямую. В обычной
    docker-сети 127.0.0.1 указывал бы внутрь самого контейнера ноды, поэтому
    нужен адрес шлюза docker0."""
    mode = probe(["docker", "inspect", "-f", "{{.HostConfig.NetworkMode}}",
                  "remnanode"]).stdout.strip()
    if mode == "host":
        return "127.0.0.1"
    gw = probe(["docker", "network", "inspect", "bridge", "-f",
                "{{range .IPAM.Config}}{{.Gateway}}{{end}}"]).stdout.strip()
    return gw or "172.17.0.1"


def warp_outbound_reference(socks_address: str) -> str:
    """Outbound и правило маршрутизации для вставки в Config Profile панели."""
    return json.dumps({
        "outboundToAdd": {
            "tag": "warp",
            "protocol": "socks",
            "settings": {
                "servers": [{"address": socks_address, "port": WARP_SOCKS_PORT}]
            },
        },
        "routingRuleToAdd": {
            "type": "field",
            "outboundTag": "warp",
            "domain": WARP_DOMAINS,
        },
        "_note": (
            "Правило добавляйте ВЫШЕ правила, отправляющего трафик в DIRECT: "
            "маршрутизация Xray выбирает первое совпавшее. Host в панели для "
            "WARP не нужен — это внутренний выход ноды, клиенту он не виден."
        ),
    }, indent=2, ensure_ascii=False) + "\n"


def _warp_check() -> tuple[bool, str]:
    """Проверяет, что через SOCKS виден чистый адрес Cloudflare."""
    r = probe(["curl", "-x", f"socks5://127.0.0.1:{WARP_SOCKS_PORT}", "-s",
               "--max-time", "10", "https://www.cloudflare.com/cdn-cgi/trace"])
    if r.returncode != 0 or not r.stdout:
        return False, ""
    warp_on = any(line.strip() in ("warp=on", "warp=plus")
                  for line in r.stdout.splitlines())
    ip = ""
    for line in r.stdout.splitlines():
        if line.startswith("ip="):
            ip = line.split("=", 1)[1].strip()
    return warp_on, ip


def ask_warp_license() -> str:
    """Ключ WARP+ спрашиваем заранее; пустой — бесплатный WARP."""
    key = questionary.text(
        "Ключ WARP+ (Enter — бесплатный WARP).\n"
        "  Бесплатные адреса сильно разделяемые, Google и OpenAI помечают их\n"
        "  как подозрительные заметно чаще.\n"
        "  Ключ:",
        default="", style=CUSTOM_STYLE).ask()
    return (key or "").strip()


def block_warp(license_key: str = "") -> None:
    step("WARP: чистый egress для нейросетей и стримингов")

    if shutil.which("docker") is None:
        raise RuntimeError("Docker не установлен — сначала установите ноду")
    ensure_packages("curl")

    os.makedirs(WARP_DIR, exist_ok=True)
    compose_path = f"{WARP_DIR}/docker-compose.yml"
    write_file(compose_path, warp_compose(license_key))
    if license_key:
        console.print("[dim]Используется ключ WARP+[/dim]")
    console.print(f"[green]✓ Конфигурация записана: {compose_path}[/green]")

    base = compose_base(compose_path)
    if base is None:
        raise RuntimeError("docker compose недоступен — контейнер WARP не запущен")
    run(base + ["pull"], check=False)
    run(base + ["up", "-d"])

    # Контейнеру нужно зарегистрироваться в Cloudflare — это не мгновенно
    console.print("[cyan]Жду, пока WARP поднимет туннель…[/cyan]")
    ok, ip = False, ""
    for _ in range(24):          # до двух минут
        ok, ip = _warp_check()
        if ok:
            break
        time.sleep(5)

    if not ok:
        logs = probe(["docker", "logs", "--tail", "20", WARP_CONTAINER]).stdout
        raise RuntimeError(
            "WARP не поднялся за две минуты — трафик через него пойти не может.\n"
            f"  Последние строки журнала контейнера:\n{logs.strip() or '  (пусто)'}")

    console.print(f"[green]✓ WARP работает, внешний адрес: {ip or 'неизвестен'}[/green]")

    socks_address = _warp_socks_address()
    ref_path = f"{INSTALL_DIR}/panel-warp-outbound.json"
    os.makedirs(INSTALL_DIR, exist_ok=True)
    write_file(ref_path, warp_outbound_reference(socks_address))
    console.print(f"[green]✓ Заготовка для панели: {ref_path}[/green]")
    console.print(f"[dim]Адрес SOCKS для ноды: {socks_address}:{WARP_SOCKS_PORT} "
                  "(определён по сетевому режиму контейнера ноды)[/dim]")

    console.print(
        "[bold yellow]Важно:[/bold yellow] серверная часть готова. В панели "
        f"Remnawave добавьте в Config Profile outbound и правило из {ref_path}. "
        "Правило должно стоять ВЫШЕ правила с DIRECT, иначе оно не сработает.")


