def menu_remnawave_node() -> None:
    # Краткая сводка о состоянии сервера
    console.print(f"[bold]Свободно на диске:[/bold] {disk_free_info()}")
    console.print(f"[bold]Текущее расписание перезагрузки:[/bold] "
                  f"{current_reboot_schedule()}")

