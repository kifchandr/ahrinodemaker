REBOOT_CRON_MARKER = "# VPN Server Hardening: автоматическая перезагрузка"


def block_cron(schedule: str = "daily") -> None:
    # Расписание выбирается пользователем в начале. Часовой пояс ставится
    # в block_timezone() как Europe/Moscow, поэтому 03:00 — именно по МСК.
    if schedule == "weekly":
        reboot_line = "0 3 * * 1 /sbin/reboot"
        human = "по понедельникам в 03:00"
    else:
        reboot_line = "0 3 * * * /sbin/reboot"
        human = "ежедневно в 03:00"

    step(f"Настройка cron (перезагрузка {human} МСК)")

    if shutil.which("crontab") is None:
        ensure_packages("cron")
    if shutil.which("crontab") is None:
        console.print("[yellow]Команда crontab не найдена даже после установки "
                      "пакета cron — расписание пропущено.[/yellow]")
        return

    # Сохраняем ВСЕ посторонние строки (certbot/acme, бэкапы, чужие задачи) —
    # удаляется только наш блок и строка перезагрузки в прежнем формате: и
    # ежедневная «0 3 * * *», и еженедельная «0 3 * * 1». Регэксп привязан к
    # нашему расписанию + /sbin/reboot, поэтому чужой reboot-крон не заденет.
    #
    # Прежняя версия удаляла ещё и любую строку со словом «remnanode» — чистка
    # старого тега. Это правило снято: задачи Hysteria2 содержат
    # `docker restart remnanode` и стирались бы при каждом прогоне этого блока.
    reboot_re = re.compile(r"^\s*0\s+3\s+\*\s+\*\s+[*1]\s+.*?/sbin/reboot\b")
    _crontab_replace_block(REBOOT_CRON_MARKER, [reboot_line],
                           drop=lambda ln: reboot_re.match(ln) is not None)
    console.print(f"[green]✓ crontab обновлён — перезагрузка {human}[/green]")


# ------------------------------------------------------------------ #
# Поиск / правка docker-compose.yml ноды (для блока логов)
# ------------------------------------------------------------------ #
COMPOSE_CANDIDATES = [
    "/opt/remnanode/docker-compose.yml",
    "/opt/remnanode/docker-compose.yaml",
    "/root/remnanode/docker-compose.yml",
    "/root/remnanode/docker-compose.yaml",
    "/opt/remnawave/node/docker-compose.yml",
    "/opt/remnawave-node/docker-compose.yml",
]


def compose_base(compose_path: str) -> list[str] | None:
    """Базовая команда compose для файла: `docker compose -f …`, `docker-compose -f …`
    или None, если ни того ни другого нет. Отсутствие docker больше не исключение."""
    if probe(["docker", "compose", "version"]).returncode == 0:
        return ["docker", "compose", "-f", compose_path]
    if shutil.which("docker-compose"):
        return ["docker-compose", "-f", compose_path]
    return None


def find_compose_candidates() -> list[str]:
    """Возвращает список найденных docker-compose.yml, относящихся к ноде."""
    found: list[str] = []
    for p in COMPOSE_CANDIDATES:
        if os.path.isfile(p) and p not in found:
            found.append(p)
    # Глубокий поиск, если в стандартных местах ничего нет
    if not found:
        try:
            res = subprocess.run(
                ["bash", "-c",
                 "find /opt /root /home -maxdepth 4 -name 'docker-compose.y*ml' "
                 "-path '*remna*' 2>/dev/null | head -n 10"],
                capture_output=True, text=True,
            )
            for line in res.stdout.splitlines():
                line = line.strip()
                if line and os.path.isfile(line) and line not in found:
                    found.append(line)
        except Exception:
            pass
    return found


def _ask_compose_manual() -> str | None:
    raw = questionary.text(
        "Путь к docker-compose.yml ноды.\n"
        "  Enter — пропустить. Без volume логи ноды останутся внутри контейнера:\n"
        "  logrotate их не увидит, а блокировка торрентов работать не будет.\n"
        "  Путь:",
        default="",
        style=CUSTOM_STYLE,
    ).ask()
    if not raw or not raw.strip():
        return None
    path = raw.strip()
    if not os.path.isfile(path):
        console.print(f"[yellow]Файл не найден: {path} — volume будет пропущен.[/yellow]")
        return None
    return path


def ask_compose_path() -> str | None:
    """Определяет путь к docker-compose.yml ноды до запуска блоков."""
    candidates = find_compose_candidates()
    if len(candidates) == 1:
        console.print(f"[green]Найден docker-compose ноды:[/green] {candidates[0]}")
        return candidates[0]
    if len(candidates) > 1:
        sel = questionary.select(
            "Найдено несколько docker-compose.yml — выберите файл ноды:",
            choices=[*candidates, "Указать вручную", "Пропустить"],
            style=CUSTOM_STYLE,
        ).ask()
        if sel is None or sel == "Пропустить":
            return None
        if sel == "Указать вручную":
            return _ask_compose_manual()
        return sel
    return _ask_compose_manual()


def patch_compose_volume(path: str, volume: str = REMNANODE_VOLUME) -> str:
    """Добавляет volume в нужный сервис, сохраняя форматирование и комментарии.
    Возвращает: 'added' | 'exists' | текст ошибки."""
    ensure("ruamel.yaml", "ruamel.yaml")
    from ruamel.yaml import YAML
    from ruamel.yaml.scalarstring import DoubleQuotedScalarString
    from ruamel.yaml.comments import CommentedSeq

    yaml = YAML()
    yaml.preserve_quotes = True
    yaml.indent(mapping=2, sequence=4, offset=2)

    with open(path, encoding="utf-8") as f:
        data = yaml.load(f)

    if not data or "services" not in data or not data["services"]:
        return "в файле нет секции services"

    services = data["services"]
    # Выбираем сервис: точное имя remnanode → единственный сервис → по подстроке
    if "remnanode" in services:
        names = ["remnanode"]
    elif len(services) == 1:
        names = [next(iter(services))]
    else:
        names = [n for n in services if "remna" in str(n).lower()] or list(services)

    changed = False
    already = False
    for name in names:
        svc = services.get(name)
        if svc is None:
            continue
        vols = svc.get("volumes")
        if vols is None:
            vols = CommentedSeq()
            svc["volumes"] = vols
        if any(str(v).strip().strip('"').strip("'") == volume for v in vols):
            already = True
            continue
        vols.append(DoubleQuotedScalarString(volume))
        changed = True

    if not changed:
        return "exists" if already else "сервис ноды не найден"

    # Файл чужой: сначала бэкап и рендер в память, и только потом атомарная
    # замена — иначе сбой в середине dump оставит ноду без compose-файла.
    import io
    buf = io.StringIO()
    yaml.dump(data, buf)
    write_file(path, buf.getvalue())
    return "added"


def recreate_node(compose_path: str) -> None:
    """Пересоздаёт контейнер ноды, чтобы применился новый volume."""
    base = compose_base(compose_path)
    if base is None:
        console.print("[yellow]docker compose не найден — пересоздайте ноду вручную "
                      "для применения volume.[/yellow]")
        return
    console.print("[cyan]Пересоздаю контейнер ноды для применения volume…[/cyan]")
    run(base + ["up", "-d", "--remove-orphans"], check=False)


# Ротация логов ноды. copytruncate обязателен: xray внутри контейнера держит
# файл открытым, и обычное переименование оставило бы его писать в уже
# отротированный inode — новые записи уходили бы «в никуда».
NODE_LOGROTATE_PATH = "/etc/logrotate.d/remnanode"
NODE_LOGROTATE_CONF = """/var/log/remnanode/*.log {
    su root root
    daily
    rotate 14
    maxsize 300M
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
}
"""


def write_logrotate_config() -> None:
    """Настраивает ротацию логов ноды.

    Вызывается и при установке ноды: установка создаёт файлы логов и volume,
    то есть гарантированно порождает растущие логи. Оставлять их без уборки
    в другом блоке значило бы отдавать сервер с миной замедленного действия —
    на заметном трафике access.log забивает диск."""
    write_file(NODE_LOGROTATE_PATH, NODE_LOGROTATE_CONF)
    console.print(f"[green]✓ Ротация логов настроена: {NODE_LOGROTATE_PATH}[/green]")


def block_remnanode_logs(compose_path: str | None) -> None:
    step("Логи remnanode: каталог + logrotate + docker volume")
    # 1. Каталог и файлы логов (та же подготовка, что и при установке ноды)
    prepare_node_logs()
    # 2. logrotate
    write_logrotate_config()
    # 3. Volume в docker-compose.yml ноды
    if not compose_path:
        # Путь спрашивается до выполнения блоков, а нода могла быть установлена
        # только что блоком node_install — тогда compose появился уже после.
        found = find_compose_candidates()
        if found:
            compose_path = found[0]
            console.print(f"[green]Найден docker-compose ноды:[/green] {compose_path}")
    if not compose_path:
        console.print("[yellow]docker-compose.yml ноды не задан — volume не добавлен.[/yellow]")
        return
    result = patch_compose_volume(compose_path)
    if result == "exists":
        console.print(f"[green]✓ Volume уже присутствует в {compose_path}[/green]")
    elif result == "added":
        console.print(f"[green]✓ Volume добавлен в {compose_path}[/green]")
        recreate_node(compose_path)
    else:
        console.print(f"[yellow]Не удалось обновить {compose_path}: {result}[/yellow]")


