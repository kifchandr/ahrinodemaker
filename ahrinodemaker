def reattach_tty() -> bool:
    """При запуске через `curl ... | python3` stdin занят телом скрипта.
    Переподключаем ввод к управляющему терминалу, иначе галочки не работают."""
    try:
        if sys.stdin is not None and sys.stdin.isatty():
            return True
    except Exception:
        pass
    try:
        tty = open("/dev/tty")
    except OSError:
        return False
    try:
        os.dup2(tty.fileno(), 0)
    except OSError:
        tty.close()
        return False
    # Держим объект в sys.stdin: prompt_toolkit читает fd 0, но ссылка нужна,
    # чтобы файл не закрылся сборщиком мусора вместе с продублированным fd.
    sys.stdin = tty
    return sys.stdin.isatty()


