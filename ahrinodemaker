_SHA_RE = re.compile(r"sha256:[0-9a-f]{64}")


def _image_from_compose_text(path: str) -> str | None:
    """Запасной разбор image: без YAML-парсера.

    Нужен, чтобы простая проверка версии ноды не тянула установку ruamel.yaml:
    раньше вход в раздел «Remnawave Node» ставил модуль ещё до того, как
    пользователь выбрал хоть один блок."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    images: list[tuple[str, str]] = []   # (имя сервиса, образ)
    service = ""
    for ln in lines:
        if re.match(r"^\s{2}\S.*:\s*$", ln) and not ln.startswith("    "):
            service = ln.strip().rstrip(":")
        m = re.match(r"^\s+image:\s*['\"]?([^'\"#\s]+)", ln)
        if m:
            images.append((service, m.group(1)))
    if not images:
        return None
    for name, image in images:
        if "remna" in name.lower():
            return image
    return images[0][1]


def _node_image_from_compose(path: str) -> str | None:
    """Достаёт имя образа сервиса ноды из docker-compose.yml."""
    try:
        # Только если модуль уже есть — ставить его ради чтения не будем.
        from ruamel.yaml import YAML
        yaml = YAML(typ="safe")
        with open(path, encoding="utf-8") as f:
            data = yaml.load(f)
    except ImportError:
        return _image_from_compose_text(path)
    except Exception:
        return None
    if not isinstance(data, dict):
        return None
    services = data.get("services") or {}
    svc = None
    if "remnanode" in services:
        svc = services["remnanode"]
    elif len(services) == 1:
        svc = next(iter(services.values()))
    else:
        for name, s in services.items():
            if "remna" in str(name).lower():
                svc = s
                break
        if svc is None and services:
            svc = next(iter(services.values()))
    if isinstance(svc, dict) and svc.get("image"):
        return str(svc["image"])
    return None


def _local_image_digests(image: str) -> set[str]:
    """sha256-дайджесты образа, имеющегося локально (пусто — образа нет)."""
    r = probe(["docker", "image", "inspect", "--format",
               "{{range .RepoDigests}}{{println .}}{{end}}{{.Id}}", image])
    return set(_SHA_RE.findall(r.stdout)) if r.returncode == 0 else set()


def _remote_image_digests(image: str) -> set[str]:
    """sha256-дайджесты образа в реестре. Пробуем buildx и manifest;
    если оба недоступны — пустое множество (проверить не удалось)."""
    env = {**os.environ, "DOCKER_CLI_EXPERIMENTAL": "enabled"}
    digests: set[str] = set()
    for cmd in (["docker", "buildx", "imagetools", "inspect", image],
                ["docker", "manifest", "inspect", image]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True,
                               env=env, timeout=25)
        except (subprocess.TimeoutExpired, OSError):
            continue
        if r.returncode == 0:
            digests |= set(_SHA_RE.findall(r.stdout))
    return digests


def node_update_status() -> tuple[str, str | None, str | None]:
    """Состояние ноды:
      'absent'  — ноды на сервере нет (пункт не показываем);
      'update'  — образ устарел или отсутствует локально (нужно обновление);
      'latest'  — установлена последняя версия (пункт скрываем);
      'unknown' — реестр недоступен, версию проверить не удалось.
    Возвращает (status, compose_path, image)."""
    try:
        candidates = find_compose_candidates()
    except Exception:
        candidates = []
    if not candidates:
        return ("absent", None, None)
    path = candidates[0]
    image = _node_image_from_compose(path)
    if not image:
        return ("absent", path, None)
    # Без docker судить об образе нельзя: раньше пустой список локальных
    # дайджестов трактовался как «нужно обновление» и предлагал бесполезный пункт.
    if shutil.which("docker") is None:
        return ("absent", path, image)
    local = _local_image_digests(image)
    if not local:
        return ("update", path, image)      # образа локально нет — точно тянем
    remote = _remote_image_digests(image)
    if not remote:
        return ("unknown", path, image)     # не смогли обратиться к реестру
    return ("latest" if (local & remote) else "update", path, image)


def block_node_update(compose_path: str | None = None) -> None:
    step("Обновление remnanode (docker compose pull + пересоздание)")
    if not compose_path:
        candidates = find_compose_candidates()
        compose_path = candidates[0] if candidates else None
    if not compose_path or not os.path.isfile(compose_path):
        console.print("[yellow]docker-compose ноды не найден — обновление пропущено.[/yellow]")
        return
    base = compose_base(compose_path)
    if base is None:
        console.print("[yellow]docker compose не найден — обновление пропущено.[/yellow]")
        return
    run(base + ["pull"])
    # Раньше здесь был `down` + `up`, что давало лишний простой ноды: compose
    # сам пересоздаёт контейнер, если образ изменился.
    # -d обязателен: без него `up` висит в foreground и блокирует скрипт
    run(base + ["up", "-d", "--remove-orphans"])
    console.print("[green]✓ remnanode обновлён и перезапущен[/green]")


