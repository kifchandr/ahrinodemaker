# Парсинг доп. портов для UFW
# ------------------------------------------------------------------ #
PORT_RE = re.compile(r"^(\d{1,5})(?::(\d{1,5}))?(?:/(tcp|udp))?$", re.IGNORECASE)


def parse_extra_ports(raw: str) -> tuple[list[str], list[str]]:
    """Разбирает список портов. Одной регулярки мало: \\d{1,5} пропускает 99999,
    а диапазон вида 2000:1000 синтаксически корректен, но бессмыслен — ufw такое
    правило отвергнет уже в процессе применения."""
    valid, invalid = [], []
    for item in (p.strip() for p in raw.split(",")):
        if not item:
            continue
        m = PORT_RE.match(item)
        if not m:
            invalid.append(item)
            continue
        start = int(m.group(1))
        end = int(m.group(2)) if m.group(2) else start
        if not (1 <= start <= 65535 and 1 <= end <= 65535) or start > end:
            invalid.append(item)
            continue
        valid.append(item)
    return valid, invalid


def ask_extra_ports() -> list[str]:
    while True:
        raw = questionary.text(
            "Доп. порты для UFW через запятую (Enter — пропустить).\n"
            "  Примеры: 8080, 5000/udp, 10000:10100/tcp",
            default="",
            style=CUSTOM_STYLE,
        ).ask()
        if raw is None:  # Ctrl+C
            return []
        if not raw.strip():
            return []
        valid, invalid = parse_extra_ports(raw)
        if invalid:
            console.print(f"[red]Некорректные значения:[/red] {', '.join(invalid)}")
            console.print("[yellow]Допустимо: порт, порт/tcp, порт/udp, диапазон вида 1000:2000/tcp. "
                          "Повторите ввод или нажмите Enter, чтобы пропустить.[/yellow]")
            continue
        return valid


