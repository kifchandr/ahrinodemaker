def _crontab_replace_block(marker: str, lines: list[str], *, drop=None) -> None:
    """Заменяет в crontab root блок, помеченный marker, сохраняя все остальные
    задачи. lines пустой — блок просто удаляется.

    drop — необязательный предикат для удаления старых записей вне блока
    (миграция с прежних форматов).

    Блоком считается строка-маркер и всё до пустой строки или следующего
    комментария: раньше удалялась ровно одна строка после маркера, и блок из
    двух задач (сертификаты Hysteria2) чистился наполовину."""
    ensure_packages("cron")
    if shutil.which("crontab") is None:
        raise RuntimeError("команда crontab не найдена (нужен пакет cron)")

    res = probe(["crontab", "-l"])
    existing = res.stdout.splitlines() if res.returncode == 0 else []

    kept: list[str] = []
    in_block = False
    for ln in existing:
        s = ln.strip()
        if s == marker:
            in_block = True
            continue
        if in_block:
            if not s or s.startswith("#"):
                in_block = False      # блок кончился, строку обрабатываем ниже
            else:
                continue
        if drop is not None and drop(ln):
            continue
        kept.append(ln)

    # Схлопываем подряд идущие пустые строки: снятие блока оставляло за собой
    # пустую строку-разделитель, и при нескольких правках их копилось всё больше
    collapsed: list[str] = []
    for ln in kept:
        if not ln.strip() and collapsed and not collapsed[-1].strip():
            continue
        collapsed.append(ln)
    kept = collapsed

    while kept and not kept[-1].strip():
        kept.pop()
    if lines:
        if kept:
            kept.append("")
        kept.append(marker)
        kept.extend(lines)

    new_cron = "\n".join(kept).strip("\n")
    run(["crontab", "-"], input_text=new_cron + "\n" if new_cron else "\n")


def _gdrive_schedule(folder_id: str, days: str) -> None:
    hour = questionary.text(
        "Час запуска очистки (0–23), по умолчанию 4:", default="4",
        style=CUSTOM_STYLE).ask()
    if hour is None:
        return
    hour = hour.strip() or "4"
    if not hour.isdigit() or not 0 <= int(hour) <= 23:
        console.print("[red]Час должен быть числом от 0 до 23.[/red]")
        return

    line = (f"0 {int(hour)} * * * FOLDER_ID={folder_id} DAYS_OLD={days} "
            f"DRY_RUN=false {GDRIVE_CLEANUP_PATH} >/dev/null 2>&1")
    _crontab_replace_block(GDRIVE_CRON_MARKER, [line])
    console.print(f"[green]✓ Очистка добавлена в cron: ежедневно в "
                  f"{int(hour):02d}:00 ({TIMEZONE})[/green]")


def _gdrive_current_schedule() -> str | None:
    res = probe(["crontab", "-l"])
    if res.returncode != 0:
        return None
    for line in res.stdout.splitlines():
        if GDRIVE_CLEANUP_PATH in line and not line.strip().startswith("#"):
            m = re.match(r"^\s*(\d+)\s+(\d+)\s", line)
            if m:
                return f"ежедневно в {int(m.group(2)):02d}:{int(m.group(1)):02d}"
            return "задано"
    return None


