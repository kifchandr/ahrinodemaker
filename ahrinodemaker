def block_cron(schedule: str = "daily") -> None:
    # Расписание выбирается пользователем в начале. Часовой пояс ставится
    # в block_timezone() как Europe/Moscow, поэтому 03:00 — именно по МСК.
    if schedule == "weekly":
        reboot_line = "0 3 * * 1 /sbin/reboot"
        human = "по понедельникам в 03:00"
    else:
        reboot_line = "0 3 * * * /sbin/reboot"
        human = "ежедневно в 03:00"

    step(f"Настройка cron (перезагрузка {human} МСК)")

    MARKER = "# VPN Server Hardening: автоматическая перезагрузка"

    if shutil.which("crontab") is None:
        console.print("[yellow]Команда crontab не найдена — установите пакет cron "
                      "(блок «Установка пакетов»). Расписание пропущено.[/yellow]")
        return

    res = probe(["crontab", "-l"])
    existing = res.stdout.splitlines() if res.returncode == 0 else []

    # Сохраняем ВСЕ посторонние строки (certbot/acme для продления сертификатов,
    # бэкапы, кастомные задачи). Удаляем только записи, добавленные этим скриптом,
    # чтобы не плодить дубликаты:
    #   • строку-маркер нашего блока;
    #   • строки со старым тегом remnanode;
    #   • строку перезагрузки самого скрипта — и ежедневную «0 3 * * *»,
    #     и еженедельную «0 3 * * 1». Регэксп жёстко привязан к нашему
    #     расписанию + /sbin/reboot, поэтому чужой reboot-крон не заденет.
    reboot_re = re.compile(r"^\s*0\s+3\s+\*\s+\*\s+[*1]\s+.*?/sbin/reboot\b")
    kept: list[str] = []
    for ln in existing:
        s = ln.strip()
        if s == MARKER:
            continue
        if "remnanode" in s:
            continue
        if reboot_re.match(ln):
            continue
        kept.append(ln)

    # Убираем хвостовые пустые строки и дописываем наш блок в конец
    while kept and not kept[-1].strip():
        kept.pop()
    if kept:
        kept.append("")  # пустая строка-разделитель для читабельности
    kept.append(MARKER)
    kept.append(reboot_line)

    new_cron = "\n".join(kept).strip("\n") + "\n"
    run(["crontab", "-"], input_text=new_cron)
    console.print(f"[green]✓ crontab обновлён — перезагрузка {human}[/green]")


