    console.print("[dim]Проверяю версию remnanode…[/dim]")
    try:
        node_status, node_path, node_image = node_update_status()
    except OSError as exc:
        # Проверка версии — вспомогательная; её сбой не должен мешать меню.
        console.print(f"[dim]Не удалось определить состояние ноды: {exc}[/dim]")
        node_status, node_path, node_image = "absent", None, None
    node_note = {
        "update":  "[yellow]доступно обновление[/yellow]",
        "latest":  "[green]установлена последняя версия[/green]",
        "unknown": "[dim]не удалось проверить версию (реестр недоступен)[/dim]",
    }.get(node_status)
    if node_note:
        suffix = f" [dim]({node_image})[/dim]" if node_image else ""
        console.print(f"[bold]remnanode:[/bold] {node_note}{suffix}")
    console.print()

    # 1. Проверяем, что уже настроено на сервере, — такие блоки по умолчанию
    #    будут БЕЗ галочки (повторно выполнять не нужно). При желании их можно
    #    отметить вручную — тогда блок отработает заново.
    console.print("[dim]Проверяю текущее состояние сервера…[/dim]")
    applied = detect_applied()
    console.print()

    # 2. Выбор блоков галочками. Уже настроенные блоки идут без галочки.
    #    Пункт обновления ноды показываем только если нода установлена и её
    #    версия не последняя (или версию не удалось проверить).
    # Ноды на сервере нет: 'absent' означает, что docker-compose не найден либо
    # в нём нет образа. В этом случае показываем пункт установки, а блок логов
    # прячем — установка сама создаёт каталог, файлы, volume и ротацию, а
    # патчить ему всё равно нечего: compose ещё не существует.
    node_missing = node_status == "absent" and not find_compose_candidates()

    shown_keys: list[str] = []
    choices = []
    for key, label, _ in BLOCKS:
        if key == "node_install":
            if node_missing:
                choices.append(questionary.Choice(label, value=key, checked=True))
                shown_keys.append(key)
            continue
        if key == "remnanode_logs" and node_missing:
            continue
        if key == "node_update":
            if node_status == "update":
                choices.append(questionary.Choice(label, value=key, checked=True))
                shown_keys.append(key)
            elif node_status == "unknown":
                choices.append(questionary.Choice(
                    label + "   [версию проверить не удалось]",
                    value=key, checked=False))
                shown_keys.append(key)
            # 'absent' и 'latest' — пункт не показываем
            continue
        is_applied = applied.get(key, False)
        suffix = "   [уже настроено]" if is_applied else ""
        if key in DEFAULT_OFF and not is_applied:
            suffix = "   [по умолчанию выкл]"
        choices.append(questionary.Choice(
            title=label + suffix,
            value=key,
            checked=not is_applied and key not in DEFAULT_OFF,
        ))
        shown_keys.append(key)

    selected = questionary.checkbox(
        "Отметьте блоки для выполнения (Space — выбрать, Enter — подтвердить):",
        choices=choices,
        style=CUSTOM_STYLE,
    ).ask()
    if not selected:
        console.print("[yellow]Ничего не выбрано — возврат в главное меню.[/yellow]")
        return

    # 3. Параметры установки ноды — спрашиваем до выполнения
    node_params: tuple[str, str] | None = None
    if "node_install" in selected:
        node_params = ask_node_install_params()
        if node_params is None:
            selected = [k for k in selected if k != "node_install"]

    # 4. Домен для Hysteria2 — только если выбран этот блок
    warp_license = ask_warp_license() if "warp" in selected else ""

