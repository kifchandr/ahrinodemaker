def _panel_reference() -> str:
    """Справка для панели. Собирается из TORRENT_PORTS, чтобы список портов
    гарантированно совпадал с тем, что применяет egress-фильтр."""
    ports_range = f"{min(TORRENT_PORTS)}-{max(p for p in TORRENT_PORTS if p < 10000)}"
