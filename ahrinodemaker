ENV = {**os.environ, "DEBIAN_FRONTEND": "noninteractive"}


def wait_for_apt_lock(timeout: int = 300) -> None:
    """Ждёт освобождения блокировки dpkg/apt — её часто держит
    unattended-upgrades сразу после загрузки сервера. Опрос идёт через fuser
    (пакет psmisc); если его нет — молча выходим и полагаемся на
    DPkg::Lock::Timeout внутри самого apt."""
    if shutil.which("fuser") is None:
        return
    locks = [
        "/var/lib/dpkg/lock-frontend",
        "/var/lib/dpkg/lock",
        "/var/lib/apt/lists/lock",
        "/var/cache/apt/archives/lock",
    ]
    waited, announced = 0, False
    while waited < timeout:
        busy = any(
            os.path.exists(lk) and
            subprocess.run(["fuser", lk], capture_output=True).returncode == 0
            for lk in locks
        )
        if not busy:
            return
        if not announced:
            console.print("[yellow]Пакетный менеджер занят (вероятно, "
                          "unattended-upgrades) — жду освобождения блокировки…[/yellow]")
            announced = True
        time.sleep(3)
        waited += 3
    console.print(f"[yellow]Блокировка apt всё ещё занята после {timeout}с — "
                  "пробую продолжить.[/yellow]")


def run(cmd, *, shell: bool = False, check: bool = True, capture: bool = False,
        input_text: str | None = None):
    # apt/apt-get падают с "Could not get lock", если блокировку dpkg держит
    # unattended-upgrades. Дожидаемся её освобождения и дополнительно просим
    # apt подождать сам (безопасно и на старых версиях — опция просто игнорится).
    if isinstance(cmd, list) and cmd and cmd[0] in ("apt-get", "apt"):
        wait_for_apt_lock()
        cmd = [cmd[0], "-o", "DPkg::Lock::Timeout=300", *cmd[1:]]
    pretty = cmd if isinstance(cmd, str) else shlex.join(cmd)
    console.print(f"[dim]$ {pretty}[/dim]")
    return subprocess.run(
        cmd, shell=shell, check=check, env=ENV, text=True,
        input=input_text,
        capture_output=capture,
    )


def probe(cmd: list[str]) -> subprocess.CompletedProcess:
    """Тихо выполняет диагностическую команду. Отсутствие бинарника — не
    исключение, а returncode 127: вызывающему достаточно проверить код."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True)
    except OSError:
        return subprocess.CompletedProcess(cmd, 127, "", "")


def write_file(path: str, content: str, *, backup: bool = True, mode: int = 0o644) -> None:
    """Атомарная запись конфига с резервной копией.

    Прямая перезапись оставляет обрезанный файл, если процесс упадёт на
    середине; запись во временный файл рядом + os.replace такого не допускает.
    Копия <файл>.bak-<время> создаётся только при первой перезаписи существующего
    файла с отличным содержимым — чтобы повторные запуски не плодили бэкапы."""
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)

    if os.path.isfile(path):
        with open(path, encoding="utf-8", errors="replace") as f:
            if f.read() == content:
                return  # содержимое уже нужное — не трогаем файл и не бэкапим
        if backup:
            stamp = time.strftime("%Y%m%d-%H%M%S")
            shutil.copy2(path, f"{path}.bak-{stamp}")

    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


